---
import SiteLogo from '../atoms/SiteLogo.astro';
---

<footer class="bg-surface-inset pt-16 pb-8" aria-labelledby="footer-heading">
  <h2 id="footer-heading" class="sr-only">Footer</h2>
  <div class="w-[90%] mx-auto">
    <div class="xl:grid xl:grid-cols-3 xl:gap-8">

      <!-- Brand & Mission Info -->
      <div class="space-y-8 xl:col-span-1">
        <a href="/" class="inline-flex items-center" aria-label="Pro Exteriors home">
          <SiteLogo class="h-11 w-auto" />
        </a>
        <p class="text-base text-text-secondary max-w-xs">
          Your trusted partner for commercial and residential exterior solutions. Local experts. Not "storm chasers."
        </p>

        <!-- CTA -->
        <div class="flex flex-col gap-3">
          <a
            href="/contact/"
            class="inline-flex w-fit items-center justify-center rounded-md bg-brand-accent px-6 py-3 text-base font-semibold text-text-on-brand shadow-sm hover:bg-brand-accent-hover"
            data-cta-name="footer_quote"
          >
            Get a Quote
          </a>
          <a href="tel:+18443367767" class="text-base font-bold text-text-primary hover:text-accent" data-cta-name="footer_phone">844-336-PROS</a>
        </div>

        <!-- Social -->
        <div class="flex items-center gap-5">
          <a href="https://www.linkedin.com/company/proexteriorsus/" target="_blank" rel="noopener" class="text-text-tertiary hover:text-accent" aria-label="Pro Exteriors on LinkedIn">
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          </a>
          <a href="https://www.facebook.com/proexteriorsus/" target="_blank" rel="noopener" class="text-text-tertiary hover:text-accent" aria-label="Pro Exteriors on Facebook">
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
          <a href="https://www.instagram.com/proexteriorsllc/" target="_blank" rel="noopener" class="text-text-tertiary hover:text-accent" aria-label="Pro Exteriors on Instagram">
            <svg class="h-6 w-6" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
          </a>
        </div>

        <!-- Accreditation & membership (swap in official BBB seal + Chamber badge from each portal — data-todo) -->
        <div class="flex flex-col gap-2">
          <a href="https://www.bbb.org/us/tx/richardson/profile/roofing-contractors/pro-exteriors-llc-0875-91303048" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm text-text-secondary hover:text-accent" data-todo="bbb-seal">
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path stroke-linecap="round" stroke-linejoin="round" d="m9 12 2 2 4-4"/></svg>
            BBB A+ Accredited
          </a>
          <a href="https://business.richardsonchamber.com/list/member/pro-exteriors-llc-25116" target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm text-text-secondary hover:text-accent" data-todo="chamber-badge">
            <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><polygon points="12 2 20 7 4 7"/><line x1="6" x2="6" y1="11" y2="18"/><line x1="10" x2="10" y1="11" y2="18"/><line x1="14" x2="14" y1="11" y2="18"/><line x1="18" x2="18" y1="11" y2="18"/><line x1="3" x2="21" y1="22" y2="22"/></svg>
            Richardson Chamber Member
          </a>
        </div>
      </div>

      <div class="mt-16 grid grid-cols-2 gap-8 xl:col-span-2 xl:mt-0">
        <div class="md:grid md:grid-cols-2 md:gap-8">
          <!-- Company Column -->
          <div>
            <h3 class="text-sm font-semibold leading-6 text-text-primary uppercase tracking-wider">Company</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li><a href="/about/" class="text-sm leading-6 text-text-secondary hover:text-accent">About Us</a></li>
              <li><a href="/team/" class="text-sm leading-6 text-text-secondary hover:text-accent">Team</a></li>
              <li><a href="/pro-ministries/" class="text-sm leading-6 text-text-secondary hover:text-accent">Pro Ministries</a></li>
              <li><a href="/careers/" class="text-sm leading-6 text-text-secondary hover:text-accent">Careers</a></li>
              <li><a href="/contact/" class="text-sm leading-6 text-text-secondary hover:text-accent">Contact</a></li>
            </ul>
          </div>

          <!-- Services Column -->
          <div class="mt-10 md:mt-0">
            <h3 class="text-sm font-semibold leading-6 text-text-primary uppercase tracking-wider">Services</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li><a href="/commercial-roofing/" class="text-sm leading-6 text-text-secondary hover:text-accent">Commercial &amp; Multifamily</a></li>
              <li><a href="/residential-roofing/" class="text-sm leading-6 text-text-secondary hover:text-accent">Residential Roofing</a></li>
              <li><a href="/proplan/" class="text-sm leading-6 text-text-secondary hover:text-accent">Roof Asset Management</a></li>
            </ul>
          </div>
        </div>

        <div class="md:grid md:grid-cols-2 md:gap-8">
          <!-- Locations Column -->
          <div>
            <h3 class="text-sm font-semibold leading-6 text-text-primary uppercase tracking-wider">Locations</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li><a href="/locations/" class="text-sm leading-6 text-text-secondary hover:text-accent">All Locations</a></li>
              <li><a href="/locations/dallas-hq/" class="text-sm leading-6 text-text-secondary hover:text-accent">Dallas HQ</a></li>
              <li><a href="/locations/fort-worth/" class="text-sm leading-6 text-text-secondary hover:text-accent">Fort Worth, TX</a></li>
              <li><a href="/locations/denver/" class="text-sm leading-6 text-text-secondary hover:text-accent">Denver, CO</a></li>
              <li><a href="/locations/wichita/" class="text-sm leading-6 text-text-secondary hover:text-accent">Wichita, KS</a></li>
              <li><a href="/locations/kansas-city/" class="text-sm leading-6 text-text-secondary hover:text-accent">Kansas City, MO</a></li>
              <li><a href="/locations/atlanta/" class="text-sm leading-6 text-text-secondary hover:text-accent">Atlanta, GA</a></li>
            </ul>
          </div>

          <!-- Legal Column -->
          <div class="mt-10 md:mt-0">
            <h3 class="text-sm font-semibold leading-6 text-text-primary uppercase tracking-wider">Legal & Utility</h3>
            <ul role="list" class="mt-6 space-y-4">
              <li><a href="/privacy/" class="text-sm leading-6 text-text-secondary hover:text-accent">Privacy Policy</a></li>
              <li><a href="/terms/" class="text-sm leading-6 text-text-secondary hover:text-accent">Terms of Service</a></li>
              <li><a href="/accessibility/" class="text-sm leading-6 text-text-secondary hover:text-accent">Accessibility</a></li>
              <li><a href="/cookies/" class="text-sm leading-6 text-text-secondary hover:text-accent">Cookies Policy</a></li>
              <li><a href="/sitemap.xml" class="text-sm leading-6 text-text-secondary hover:text-accent">Sitemap</a></li>
            </ul>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Strip -->
    <div class="mt-16 border-t border-border pt-8 sm:mt-20 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">

      <!-- Certification badges — wrap on mobile -->
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs text-text-tertiary font-semibold uppercase shrink-0">Certifications:</span>
        <span class="px-3 py-1 bg-border text-xs text-text-tertiary rounded" data-todo="cert-gaf">GAF</span>
        <span class="px-3 py-1 bg-border text-xs text-text-tertiary rounded" data-todo="cert-carlisle">Carlisle</span>
        <span class="px-3 py-1 bg-border text-xs text-text-tertiary rounded" data-todo="cert-versico">Versico</span>
      </div>

      <p class="text-xs leading-5 text-text-tertiary">
        &copy; {new Date().getFullYear()} Pro Exteriors. All rights reserved.
      </p>
    </div>
  </div>
</footer>
