---
import SiteLogo from '../atoms/SiteLogo.astro';
---

<header class="bg-surface border-b border-border sticky top-0 z-50">
  <div class="w-[90%] mx-auto">
    <div class="flex h-40 justify-between items-center">

      <div class="flex-shrink-0 flex items-center">
        <a href="/" class="inline-flex items-center" aria-label="Pro Exteriors home">
          <SiteLogo class="h-28 w-auto" />
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-7">
        <!-- Services Dropdown -->
        <details class="relative group">
          <summary class="inline-flex items-center text-base font-medium text-text-secondary hover:text-accent cursor-pointer list-none whitespace-nowrap">
            Services
            <svg class="ml-1.5 h-4 w-4" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
            </svg>
          </summary>
          <div class="absolute z-10 -ml-4 mt-3 w-80 transform px-2 sm:px-0 hidden group-open:block">
            <div class="overflow-hidden rounded-lg shadow-lg ring-1 ring-black ring-opacity-5">
              <div class="bg-surface-elevated py-4">
                <a href="/residential-roofing/" class="flex items-center px-5 py-3 hover:bg-surface-inset group/item" data-cta-name="nav_residential">
                  <div>
                    <p class="text-base font-semibold text-text-primary">Residential Services</p>
                    <p class="text-sm text-text-secondary mt-0.5">Roof replacement, storm damage, emergency repair</p>
                  </div>
                </a>
                <a href="/commercial-roofing/" class="flex items-center px-5 py-3 hover:bg-surface-inset group/item" data-cta-name="nav_commercial">
                  <div>
                    <p class="text-base font-semibold text-text-primary">Commercial &amp; Multifamily</p>
                    <p class="text-sm text-text-secondary mt-0.5">Low-slope, metal systems, institutional portfolios</p>
                  </div>
                </a>
                <a href="/proplan/" class="flex items-center px-5 py-3 hover:bg-surface-inset group/item" data-cta-name="nav_proplan">
                  <div>
                    <p class="text-base font-semibold text-text-primary">Roof Asset Management</p>
                    <p class="text-sm text-text-secondary mt-0.5">Pro Plan™ maintenance programs &amp; inspections</p>
                  </div>
                </a>
              </div>
            </div>
          </div>
        </details>

        <a href="/locations/" class="inline-flex items-center text-base font-medium text-text-secondary hover:text-accent whitespace-nowrap" aria-label="Locations We Serve">Locations We Serve</a>
        <a href="/projects/" class="inline-flex items-center text-base font-medium text-text-secondary hover:text-accent whitespace-nowrap">Projects</a>
        <a href="/about/" class="inline-flex items-center text-base font-medium text-text-secondary hover:text-accent whitespace-nowrap">About</a>
        <a href="/blog/" class="inline-flex items-center text-base font-medium text-text-secondary hover:text-accent whitespace-nowrap">Resources</a>
        <a href="/contact/" class="inline-flex items-center text-base font-medium text-text-secondary hover:text-accent whitespace-nowrap">Contact</a>
      </nav>

      <!-- Utility Nav (Desktop) -->
      <div class="hidden lg:flex items-center gap-6">
        <a href="/portal/" class="text-base font-medium text-text-tertiary hover:text-accent whitespace-nowrap">Portal Login</a>
        <a href="tel:+18443367767" class="text-base font-bold text-text-primary hover:text-accent whitespace-nowrap" data-cta-name="header_phone">844-336-PROS</a>
        <a href="/contact/" class="inline-flex items-center justify-center rounded-md border border-transparent bg-brand-accent px-6 py-3 text-base font-semibold text-text-on-brand shadow-sm hover:bg-brand-accent-hover whitespace-nowrap" data-cta-name="header_quote">
          Get a Quote
        </a>
      </div>

      <!-- Mobile menu button -->
      <div class="flex items-center lg:hidden">
        <details class="group">
          <summary class="inline-flex items-center justify-center rounded-md p-3 text-text-tertiary hover:bg-surface-inset hover:text-text-secondary focus:outline-none focus:ring-2 focus:ring-inset focus:ring-accent cursor-pointer list-none">
            <span class="sr-only">Open main menu</span>
            <svg class="block h-8 w-8 group-open:hidden" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
            </svg>
            <svg class="hidden h-8 w-8 group-open:block" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </summary>
          <!-- Mobile Menu Drawer -->
          <div class="absolute left-0 top-40 w-full bg-surface shadow-lg z-50">
            <div class="space-y-1 pb-3 pt-2 px-6">
              <!-- Services — flat three-item list on mobile -->
              <details class="group/sub">
                <summary class="flex items-center justify-between py-3 text-lg font-medium text-text-secondary hover:bg-surface-inset hover:text-accent cursor-pointer list-none">
                  Services
                  <svg class="h-5 w-5 transition-transform group-open/sub:rotate-180" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                    <path fill-rule="evenodd" d="M5.293 7.293a1 1 0 011.414 0L10 10.586l3.293-3.293a1 1 0 111.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 010-1.414z" clip-rule="evenodd" />
                  </svg>
                </summary>
                <div class="pl-3 mt-1 space-y-1">
                  <a href="/residential-roofing/" class="block py-2 text-base text-text-secondary hover:text-accent">Residential Services</a>
                  <a href="/commercial-roofing/" class="block py-2 text-base text-text-secondary hover:text-accent">Commercial &amp; Multifamily</a>
                  <a href="/proplan/" class="block py-2 text-base text-text-secondary hover:text-accent">Roof Asset Management</a>
                </div>
              </details>
              <a href="/locations/" class="block py-3 text-lg font-medium text-text-secondary hover:bg-surface-inset hover:text-accent" aria-label="Locations We Serve">Locations We Serve</a>
              <a href="/projects/" class="block py-3 text-lg font-medium text-text-secondary hover:bg-surface-inset hover:text-accent">Projects</a>
              <a href="/about/" class="block py-3 text-lg font-medium text-text-secondary hover:bg-surface-inset hover:text-accent">About</a>
              <a href="/blog/" class="block py-3 text-lg font-medium text-text-secondary hover:bg-surface-inset hover:text-accent">Resources</a>
              <a href="/contact/" class="block py-3 text-lg font-medium text-text-secondary hover:bg-surface-inset hover:text-accent">Contact</a>
            </div>
            <div class="border-t border-border pb-5 pt-4 px-6 space-y-3">
              <a href="/portal/" class="block text-lg font-medium text-text-tertiary hover:text-accent">Portal Login</a>
              <a href="tel:+18443367767" class="block text-lg font-bold text-text-primary hover:text-accent">844-336-PROS</a>
              <a href="/contact/" class="mt-2 block w-full rounded-md bg-brand-accent px-6 py-3 text-center text-lg font-semibold text-text-on-brand shadow hover:bg-brand-accent-hover">Get a Quote</a>
            </div>
          </div>
        </details>
      </div>

    </div>
  </div>
</header>
