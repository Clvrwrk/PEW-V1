---
import BaseLayout from '../../../components/seo/BaseLayout.astro';
import HeroSection from '../../../components/molecules/HeroSection.astro';
import Breadcrumb from '../../../components/molecules/Breadcrumb.astro';
import LeadCaptureForm from '../../../components/molecules/LeadCaptureForm.astro';
import { contactPageSchema } from '../../../lib/schema/ContactPage';
import { breadcrumbSchema } from '../../../lib/schema/BreadcrumbList';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Contact', href: '/contact/' },
  { label: 'Emergency', href: '/contact/emergency/' },
];
---

<BaseLayout
  title="Emergency Roof Help | Pro Exteriors"
  description="Request emergency roof help from Pro Exteriors for active leaks, storm openings, tarp installation, and urgent roof stabilization."
  canonicalPath="/contact/emergency/"
  jsonLd={[contactPageSchema(), breadcrumbSchema(breadcrumbs)]}
>
  <Breadcrumb items={breadcrumbs.slice(1)} />
  <HeroSection
    image="/images/residential-hero.webp"
    title="Emergency Roof Help"
    subtitle="Active leak, storm opening, or urgent tarp need? Send the basics and call if water is entering the structure now."
    primaryCta={{ label: 'Call Emergency Line', href: 'tel:4695351708' }}
  />
  <section class="mx-auto max-w-3xl px-4 py-16">
    <LeadCaptureForm
      ctaId="contact-emergency"
      source="Website – Emergency Roof Help"
      intent="service"
      propertyType="Residential"
      serviceType="Storm Damage"
      formType="emergency-roof-help"
      campaign="phase-1-emergency-intake"
      noteLabel="Emergency details"
      notePlaceholder="Tell us what happened, whether water is entering, where the damage is, and whether the roof needs tarping."
      submitLabel="Request Emergency Help"
    />
  </section>
</BaseLayout>
