---
import BaseLayout from '../../../components/seo/BaseLayout.astro';
import HeroSection from '../../../components/molecules/HeroSection.astro';
import Breadcrumb from '../../../components/molecules/Breadcrumb.astro';
import LeadCaptureForm from '../../../components/molecules/LeadCaptureForm.astro';
import { contactPageSchema } from '../../../lib/schema/ContactPage';
import { breadcrumbSchema } from '../../../lib/schema/BreadcrumbList';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Contact', href: '/contact/' },
  { label: 'Commercial RFQ', href: '/contact/commercial/' },
];
---

<BaseLayout
  title="Commercial Roofing RFQ | Pro Exteriors"
  description="Submit a commercial roofing RFQ for assessment, repair, replacement, maintenance, or multi-site portfolio work with Pro Exteriors."
  canonicalPath="/contact/commercial/"
  jsonLd={[contactPageSchema(), breadcrumbSchema(breadcrumbs)]}
>
  <Breadcrumb items={breadcrumbs.slice(1)} />
  <HeroSection
    image="/images/commercial-hero.webp"
    title="Commercial Roofing RFQ"
    subtitle="Give us the building type, roof size, system, and timing. We will route it to the commercial team."
    primaryCta={{ label: 'Call (469) 535-1708', href: 'tel:4695351708' }}
  />
  <section class="mx-auto max-w-3xl px-4 py-16">
    <LeadCaptureForm
      ctaId="contact-commercial-rfq"
      source="Website – Commercial RFQ"
      intent="lead"
      propertyType="Commercial"
      formType="commercial-rfq"
      campaign="phase-1-commercial-rfq"
      noteLabel="Project details"
      notePlaceholder="Roof size, building type, active leaks, preferred system, timeline, and procurement requirements."
      submitLabel="Submit Commercial RFQ"
    />
  </section>
</BaseLayout>
