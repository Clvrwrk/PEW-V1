---
import BaseLayout from '../../components/seo/BaseLayout.astro';
import HeroSection from '../../components/molecules/HeroSection.astro';
import Breadcrumb from '../../components/molecules/Breadcrumb.astro';
import Icon from '../../components/atoms/Icon.astro';
import FAQ from '../../components/molecules/FAQ.astro';
import LeadCaptureForm from '../../components/molecules/LeadCaptureForm.astro';
import { contactPageSchema } from '../../lib/schema/ContactPage';
import { breadcrumbSchema } from '../../lib/schema/BreadcrumbList';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Contact', href: '/contact/' },
];
const schemaPayload = [contactPageSchema(), breadcrumbSchema(breadcrumbs)];

const trustPoints = [
  'Free inspections',
  'No-obligation estimates',
  'Same-day emergency response',
  'Serving 16 states',
];

const faqs = [
  {
    question: "What is the main Pro Exteriors phone number?",
    answer: "Our production line is 844-336-PROS. For service division and Pro Plan inquiries, call 866-336-PROS or email service@proexteriorsus.com."
  },
  {
    question: "How quickly can you respond to an emergency?",
    answer: "We deploy emergency response crews from each of our state markets. For active storm damage, tarping response is typically within 48 hours. Call 844-336-PROS for immediate dispatch."
  },
  {
    question: "Do you provide free inspections?",
    answer: "Yes — residential inspections are free of charge. For commercial properties, we provide a complimentary initial assessment for projects over 10,000 sq ft."
  },
  {
    question: "What states do you service?",
    answer: "We operate in 16 states with physical offices in Texas, Kansas, Colorado, Georgia, North Carolina, and Missouri. Full service area on our Locations We Serve page."
  },
];
---

<BaseLayout
  title="Contact Pro Exteriors | 844-336-PROS"
  description="Talk to a Pro Exteriors specialist. Commercial RFQ, residential inspection, or emergency response — get the right team, fast."
  canonicalPath="/contact/"
  jsonLd={schemaPayload}
>
  <Breadcrumb items={breadcrumbs.slice(1)} />
  <HeroSection
    image="/images/commercial-hero.webp"
    title="Get in Touch"
    subtitle="Commercial RFQ, residential inspection, service request, or emergency response — reach the right team directly."
    primaryCta={{ label: "Call 844-336-PROS", href: "tel:+18443367767" }}
  />

  {/* Primary conversion: one form, routes all four lanes. */}
  <section class="bg-surface-inset py-16 sm:py-20">
    <div class="w-[90%] max-w-6xl mx-auto grid gap-10 lg:grid-cols-5 lg:items-start">
      <div class="lg:col-span-3">
        <h2 class="text-3xl sm:text-4xl font-display font-bold text-text-primary">Request your free estimate</h2>
        <p class="mt-3 text-lg text-text-secondary">Two quick taps tell us who to send it to — then a few details. Most requests get a same-day response.</p>
        <div class="mt-8">
          <LeadCaptureForm
            ctaId="contact-hub"
            source="Website – Contact Page"
            submitLabel="Submit request"
          />
        </div>
      </div>

      <aside class="lg:col-span-2 grid gap-6 content-start">
        <div class="rounded-2xl bg-surface-elevated ring-1 ring-border p-6">
          <h3 class="text-lg font-bold text-text-primary">Prefer to talk to a person?</h3>
          <div class="mt-4">
            <p class="text-sm text-text-secondary">Sales &amp; new projects</p>
            <a href="tel:+18443367767" class="text-2xl font-extrabold text-accent hover:underline">844-336-PROS</a>
          </div>
          <div class="mt-4">
            <p class="text-sm text-text-secondary">Service division &amp; Pro Plan</p>
            <a href="tel:+18663367767" class="text-2xl font-extrabold text-accent hover:underline">866-336-PROS</a>
            <a href="mailto:service@proexteriorsus.com" class="mt-1 block text-sm text-text-secondary hover:underline">service@proexteriorsus.com</a>
          </div>
        </div>

        <div class="rounded-2xl border-2 border-accent bg-[#FCE8E8] p-6">
          <p class="font-bold text-text-primary">Active leak or storm damage?</p>
          <p class="mt-1 text-sm text-text-secondary">Don't wait on a form — same-day emergency tarping is available.</p>
          <a href="tel:+18443367767" class="mt-4 inline-flex min-h-12 items-center justify-center rounded-md bg-accent px-5 py-3 font-bold text-text-on-brand hover:bg-brand-accent-hover focus:outline-none focus:ring-2 focus:ring-accent focus:ring-offset-2">
            Call the emergency line
          </a>
        </div>

        <ul class="grid gap-3 rounded-2xl bg-surface-elevated ring-1 ring-border p-6">
          {trustPoints.map((point) => (
            <li class="flex items-center gap-3 text-sm text-text-secondary">
              <Icon name="check-circle" class="w-5 h-5 text-emerald-600 flex-shrink-0" />
              {point}
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </section>

  {/* Trust band */}
  <section class="bg-surface-inverted py-8">
    <div class="w-[90%] max-w-6xl mx-auto flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-center text-sm font-semibold text-text-inverted">
      <span>16 states served</span>
      <span class="text-text-inverted-secondary" aria-hidden="true">·</span>
      <span>BBB A+ accredited</span>
      <span class="text-text-inverted-secondary" aria-hidden="true">·</span>
      <span>Free inspections</span>
      <span class="text-text-inverted-secondary" aria-hidden="true">·</span>
      <span>No-obligation estimates</span>
    </div>
  </section>

  <section class="py-20">
    <div class="w-[90%] mx-auto max-w-4xl">
      <h2 class="text-3xl font-bold text-center mb-12 text-text-primary">Contact FAQ</h2>
      <FAQ faqs={faqs} />
    </div>
  </section>
</BaseLayout>
