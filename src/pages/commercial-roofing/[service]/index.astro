---
/**
 * Commercial service-detail template — magazine-quality layout.
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../components/seo/BaseLayout.astro';
import ServiceHero from '../../../components/molecules/ServiceHero.astro';
import SplitIntro from '../../../components/molecules/SplitIntro.astro';
import BenefitsGrid from '../../../components/molecules/BenefitsGrid.astro';
import StructureTypes from '../../../components/molecules/StructureTypes.astro';
import QualityProcess from '../../../components/molecules/QualityProcess.astro';
import ProjectGallery from '../../../components/molecules/ProjectGallery.astro';
import CTABanner from '../../../components/molecules/CTABanner.astro';
import FAQ from '../../../components/molecules/FAQ.astro';
import ServiceCard from '../../../components/molecules/ServiceCard.astro';
import CaseStudyCard from '../../../components/molecules/CaseStudyCard.astro';
import PartnerNetworkDisclosure from '../../../components/atoms/PartnerNetworkDisclosure.astro';
import ContentByline from '../../../components/molecules/ContentByline.astro';
import EeatContactBar from '../../../components/molecules/EeatContactBar.astro';
import InlineCaseStudy from '../../../components/molecules/InlineCaseStudy.astro';
import Button from '../../../components/atoms/Button.astro';
import {
  buildCommercialMoneyPageGraph,
  PE_COMMERCIAL_MARKETS,
} from '../../../lib/schema/commercialMoneyPage';
import CaseStudyPhotoGrid from '../../../components/molecules/CaseStudyPhotoGrid.astro';
import {
  COMMERCIAL_SERVICE_PHOTOS,
  resolveCaseStudyPhotos,
} from '../../../data/case-study-photos.manifest';
import { CHRIS_HUSSEY_UPDATED } from '../../../lib/people/chris-hussey';

export async function getStaticPaths() {
  const urlSegment = (canonicalPath: string): string =>
    canonicalPath.replace(/\/$/, '').split('/').pop() ?? '';

  const services = await getCollection('services', ({ data }) => data.vertical === 'commercial');
  return services.map((entry) => ({
    params: { service: urlSegment(entry.data.canonicalPath) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'services'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const data = entry.data;

const hasMagazineLayout = !!(data.intro || data.benefits || data.processSteps);

const allCommercial = await getCollection('services', ({ data: d }) => d.vertical === 'commercial');
const repairHub = allCommercial.find((s) => s.data.canonicalPath === '/commercial-roofing/repair/');
const linkTargets = [
  repairHub,
  ...allCommercial.filter(
    (s) =>
      s.slug !== entry.slug &&
      [
        '/commercial-roofing/roof-coatings/',
        '/commercial-roofing/epdm/',
        '/commercial-roofing/tpo/',
        '/commercial-roofing/flat-roof-repair/',
        '/commercial-roofing/leak-repair/',
      ].includes(s.data.canonicalPath),
  ),
].filter(Boolean) as CollectionEntry<'services'>[];
const siblings = linkTargets.slice(0, 6);

const caseStudies = await getCollection('caseStudies', ({ data: d }) => d.industryCategory === 'commercial');
const topStudies = caseStudies.slice(0, 2);

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Commercial Roofing', href: '/commercial-roofing/' },
  { label: data.name, href: data.canonicalPath },
];

const offices = await getCollection('offices');
const contactOffice = data.contactOffice ?? 'dallas-hq';
const officeEntry = offices.find((o) => o.slug === contactOffice);
const contentUpdated =
  data.contentUpdated?.toISOString().slice(0, 10) ?? CHRIS_HUSSEY_UPDATED;

const localBusiness = officeEntry
  ? {
      name: `${officeEntry.data.address.city}, ${officeEntry.data.address.state}`,
      address: `${officeEntry.data.address.street}, ${officeEntry.data.address.city}, ${officeEntry.data.address.state} ${officeEntry.data.address.zip}`,
      phone: officeEntry.data.phone,
      email: 'Office@proexteriorsus.com',
      url: `https://proexteriorsus.com${officeEntry.data.canonicalPath}`,
      lat: officeEntry.data.lat,
      lng: officeEntry.data.lng,
    }
  : undefined;

const fieldPhotos = resolveCaseStudyPhotos(COMMERCIAL_SERVICE_PHOTOS[entry.slug] ?? []);

const schemaPayload = buildCommercialMoneyPageGraph({
  service: { name: data.name, description: data.description, url: data.canonicalPath },
  breadcrumbs,
  faqs: data.faqs,
  areaServed: PE_COMMERCIAL_MARKETS,
  dateModified: contentUpdated,
  localBusiness,
  caseStudyImages: [
    ...(data.caseStudies ?? [])
      .filter((c) => c.image)
      .map((c) => ({ src: c.image!, caption: c.imageAlt ?? c.title })),
    ...fieldPhotos.map((p) => ({
      src: p.image,
      caption: p.imageAlt,
      dateCreated: p.takenAt,
      name: `${p.stage}: ${p.workType}`,
    })),
  ],
});

const bylineUpdated = contentUpdated;
const topCtaHref = data.ctaBanner?.ctaHref ?? '/contact/?vertical=commercial&service=repair-assessment';
const topCtaText = data.ctaBanner?.ctaText ?? 'Request repair assessment';
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonicalPath={data.canonicalPath}
  jsonLd={schemaPayload}
>
  <ServiceHero
    title={data.h1}
    image={data.heroImage}
    video={data.heroVideo}
    breadcrumbs={breadcrumbs.slice(1)}
  />

  <section class="border-b border-border bg-surface-inset py-6">
    <div class="mx-auto flex max-w-7xl flex-col gap-4 px-4 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
      <ContentByline
        author={data.author}
        reviewer={data.expertReviewer}
        updated={bylineUpdated}
      />
      <Button href={topCtaHref} variant="primary">{topCtaText}</Button>
    </div>
  </section>

  {hasMagazineLayout ? (
    <>
      {data.intro && (
        <SplitIntro
          heading={data.intro.heading}
          body={data.intro.body}
          image={data.intro.image}
          badges={data.intro.badges}
        />
      )}

      {data.benefits && (
        <BenefitsGrid
          heading={data.benefits.heading}
          subtitle={data.benefits.subtitle}
          items={data.benefits.items}
        />
      )}

      {data.structureTypes && (
        <StructureTypes
          heading={data.structureTypes.heading}
          items={data.structureTypes.items}
        />
      )}

      {data.processSteps && (
        <QualityProcess
          heading={data.processSteps.heading}
          image={data.processSteps.image}
          steps={data.processSteps.steps}
        />
      )}

      {data.galleryImages && data.galleryImages.length > 0 && (
        <ProjectGallery
          heading={`Completed ${data.name} Projects`}
          images={data.galleryImages}
        />
      )}

      {fieldPhotos.length > 0 && (
        <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
          <CaseStudyPhotoGrid photos={fieldPhotos.map((p) => ({
            image: p.image,
            imageAlt: p.imageAlt,
            stage: p.stage,
            caption: p.imageAlt,
          }))} />
        </div>
      )}

      {data.caseStudies && data.caseStudies.length > 0 && (
        <section class="py-16 sm:py-20 bg-surface-inset">
          <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <h2 class="text-3xl font-display font-bold text-text-primary">Field case studies</h2>
            <p class="mt-2 text-text-secondary max-w-2xl">
              Named and anonymized commercial work with documented scopes and field photos. Texas Motor Speedway is named with permission.
            </p>
            <div class="mt-10 grid gap-8 md:grid-cols-2">
              {data.caseStudies.map((study) => (
                <InlineCaseStudy {...study} />
              ))}
            </div>
          </div>
        </section>
      )}

      {topStudies.length > 0 && !data.caseStudies?.length && (
        <section class="py-16 sm:py-24">
          <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
              {topStudies.map((study) => (
                <CaseStudyCard
                  title={study.data.projectName}
                  description={study.data.description}
                  href={study.data.canonicalPath}
                  image={study.data.heroImage ?? '/images/projects/tpo-gallery-1.webp'}
                  industryTag={study.data.industryTag ?? study.data.industryCategory.toUpperCase()}
                  industryIcon={study.data.industryIcon ?? 'building'}
                  stats={study.data.stats ?? []}
                />
              ))}
            </div>
          </div>
        </section>
      )}

      {entry.body && entry.body.trim().length > 50 && (
        <article class="prose prose-slate mx-auto max-w-3xl px-4 py-16">
          <Content />
        </article>
      )}

      <div class="mx-auto max-w-3xl px-4 pb-8">
        <EeatContactBar officeSlug={contactOffice} />
      </div>
    </>
  ) : (
    <>
      <article class="prose mx-auto max-w-3xl px-4 py-16">
        <Content />
      </article>
      <div class="mx-auto max-w-3xl px-4 pb-8">
        <EeatContactBar officeSlug={contactOffice} />
      </div>
      {data.partnerFulfilled && (
        <div class="mx-auto max-w-3xl px-4 pb-8">
          <PartnerNetworkDisclosure />
        </div>
      )}
    </>
  )}

  {data.faqs && data.faqs.length > 0 && (
    <section class="py-16 sm:py-24">
      <div class="mx-auto max-w-4xl px-4">
        <h2 class="mb-12 text-center text-3xl font-display font-bold tracking-tight text-text-primary">Service FAQ</h2>
        <FAQ faqs={data.faqs} emitSchema={false} />
      </div>
    </section>
  )}

  {siblings.length > 0 && (
    <section class="py-16 sm:py-24 bg-surface-inset">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="mb-12 text-center text-3xl font-display font-bold tracking-tight text-text-primary">Related commercial services</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {siblings.map((sibling) => (
            <ServiceCard
              title={sibling.data.name}
              description={sibling.data.description}
              href={sibling.data.canonicalPath}
              image={sibling.data.heroImage}
              icon={sibling.data.cardIcon ?? 'building'}
              eyebrow="COMMERCIAL"
            />
          ))}
        </div>
        <p class="mt-8 text-center text-sm text-text-secondary">
          Local programs: <a href="/commercial-roofing/dallas/" class="text-accent hover:underline">commercial roofing Dallas</a>
          {' · '}
          <a href="/commercial-roofing/atlanta/" class="text-accent hover:underline">commercial roofing Atlanta</a>
        </p>
      </div>
    </section>
  )}

  {data.ctaBanner ? (
    <CTABanner
      heading={data.ctaBanner.heading}
      subtitle={data.ctaBanner.subtitle}
      ctaText={data.ctaBanner.ctaText}
      ctaHref={data.ctaBanner.ctaHref}
    />
  ) : (
    <CTABanner
      heading={`Ready to discuss ${data.name.toLowerCase()}?`}
      subtitle="Talk to a specialist about your commercial roofing needs."
      ctaText="Get a Quote"
      ctaHref="/contact/?vertical=commercial"
    />
  )}
</BaseLayout>