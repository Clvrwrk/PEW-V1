---
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../components/seo/BaseLayout.astro';
import HeroSection from '../../../components/molecules/HeroSection.astro';
import Breadcrumb from '../../../components/molecules/Breadcrumb.astro';
import FAQ from '../../../components/molecules/FAQ.astro';
import CTABanner from '../../../components/molecules/CTABanner.astro';
import Card from '../../../components/molecules/Card.astro';
import ContentByline from '../../../components/molecules/ContentByline.astro';
import EeatContactBar from '../../../components/molecules/EeatContactBar.astro';
import InlineCaseStudy from '../../../components/molecules/InlineCaseStudy.astro';
import Button from '../../../components/atoms/Button.astro';
import {
  ATLANTA_MARKETS,
  DFW_MARKETS,
  buildCommercialMoneyPageGraph,
} from '../../../lib/schema/commercialMoneyPage';
import { CHRIS_HUSSEY_UPDATED } from '../../../lib/people/chris-hussey';
import CaseStudyPhotoGrid from '../../../components/molecules/CaseStudyPhotoGrid.astro';
import {
  COMMERCIAL_CITY_PHOTOS,
  resolveCaseStudyPhotos,
} from '../../../data/case-study-photos.manifest';

export async function getStaticPaths() {
  const urlSegment = (canonicalPath: string): string =>
    canonicalPath.replace(/\/$/, '').split('/').pop() ?? '';

  const cities = await getCollection('cities', ({ data }) => data.vertical === 'commercial');
  return cities.map((entry) => ({
    params: { city: urlSegment(entry.data.canonicalPath) },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'cities'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const data = entry.data;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Commercial Roofing', href: '/commercial-roofing/' },
  { label: data.name, href: data.canonicalPath },
];

const areaServed = data.state === 'GA' ? ATLANTA_MARKETS : DFW_MARKETS;
const offices = await getCollection('offices');
const requestedOffice = data.contactOffice ?? data.nearestOffice;
let officeEntry = offices.find((o) => o.slug === requestedOffice);
let contactOffice = requestedOffice;
if (!officeEntry) {
  contactOffice = data.state === 'GA' ? 'atlanta' : 'dallas-hq';
  officeEntry = offices.find((o) => o.slug === contactOffice);
}
const contentUpdated =
  data.contentUpdated?.toISOString().slice(0, 10) ?? CHRIS_HUSSEY_UPDATED;

const localBusiness = officeEntry
  ? {
      name: `${officeEntry.data.address.city}, ${officeEntry.data.address.state}`,
      address: `${officeEntry.data.address.street}, ${officeEntry.data.address.city}, ${officeEntry.data.address.state} ${officeEntry.data.address.zip}`,
      phone: officeEntry.data.phone,
      email: 'Office@proexteriorsus.com',
      url: `https://proexteriorsus.com${officeEntry.data.canonicalPath}`,
      lat: officeEntry.data.lat,
      lng: officeEntry.data.lng,
    }
  : undefined;

const fieldPhotos = resolveCaseStudyPhotos(COMMERCIAL_CITY_PHOTOS[entry.slug] ?? []);

const schemaPayload = buildCommercialMoneyPageGraph({
  service: {
    name: `Commercial roofing ${data.name}`,
    description: data.description,
    url: data.canonicalPath,
  },
  breadcrumbs,
  faqs: data.faqs,
  areaServed,
  dateModified: contentUpdated,
  localBusiness,
  caseStudyImages: [
    ...(data.caseStudies ?? [])
      .filter((c) => c.image)
      .map((c) => ({ src: c.image!, caption: c.imageAlt ?? c.title })),
    ...fieldPhotos.map((p) => ({
      src: p.image,
      caption: p.imageAlt,
      dateCreated: p.takenAt,
      name: `${p.stage}: ${p.workType}`,
    })),
  ],
});
---

<BaseLayout title={data.title} description={data.description} canonicalPath={data.canonicalPath} jsonLd={schemaPayload}>
  <Breadcrumb items={breadcrumbs.slice(1)} emitSchema={false} />

  <HeroSection
    title={data.h1}
    subtitle={`Commercial roof repair, coatings, and membrane service for ${data.name}, ${data.state} — backed by field data, not franchise scripts.`}
    primaryCta={{ label: 'Request Commercial Assessment', href: '/contact/commercial/' }}
    secondaryCta={{ label: 'Commercial roof repair', href: '/commercial-roofing/repair/' }}
    image={data.heroImage}
  />

  <section class="border-b border-border bg-surface-inset py-6">
    <div class="mx-auto flex max-w-7xl flex-col gap-4 px-4 sm:flex-row sm:items-center sm:justify-between sm:px-6 lg:px-8">
      <ContentByline author={data.author} reviewer={data.expertReviewer} updated={contentUpdated} />
      <Button href="/contact/commercial/" variant="primary">Start commercial RFQ</Button>
    </div>
  </section>

  <section class="py-12">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
        <Card eyebrow="REPAIR" title="Commercial roof repair" description="Leak triage, membrane patches, and documented scopes — see our repair pillar and Repair Index." />
        <Card eyebrow="SYSTEMS" title="TPO, EPDM, coatings" description="System-specific crews with manufacturer-certified materials in every PE market." />
        <Card eyebrow="LOCAL" title={`${data.name} storm history`} description="Hail and wind data in the page body cites NOAA Storm Events (2016–2026)." />
      </div>
      <p class="mt-8 text-center text-sm text-text-secondary">
        <a href="/commercial-roofing/repair/" class="text-accent hover:underline">Commercial roof repair</a>
        {' · '}
        <a href="/commercial-roofing/roof-coatings/" class="text-accent hover:underline">Commercial roof coating</a>
        {' · '}
        <a href="/commercial-roofing/flat-roof-repair/" class="text-accent hover:underline">Flat roof repair</a>
        {' · '}
        <a href="/commercial-roofing/leak-repair/" class="text-accent hover:underline">Commercial roof leak repair</a>
        {' · '}
        <a href={`/locations/${contactOffice}/`} class="text-accent hover:underline">Local office</a>
      </p>
    </div>
  </section>

  <article class="prose prose-lg mx-auto max-w-3xl px-4 py-16">
    <Content />
  </article>

  {fieldPhotos.length > 0 && (
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 pb-8">
      <CaseStudyPhotoGrid photos={fieldPhotos.map((p) => ({
        image: p.image,
        imageAlt: p.imageAlt,
        stage: p.stage,
        caption: p.imageAlt,
      }))} />
    </div>
  )}

  {data.caseStudies && data.caseStudies.length > 0 && (
    <section class="py-16 bg-surface-inset">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-display font-bold text-text-primary">Recent work in this market</h2>
        <div class="mt-10 grid gap-8 md:grid-cols-2">
          {data.caseStudies.map((study) => (
            <InlineCaseStudy {...study} />
          ))}
        </div>
      </div>
    </section>
  )}

  <div class="mx-auto max-w-3xl px-4 pb-8">
    <EeatContactBar officeSlug={contactOffice} />
  </div>

  {data.faqs && data.faqs.length > 0 && (
    <section class="bg-surface-inset py-16">
      <div class="mx-auto max-w-4xl px-4">
        <h2 class="mb-10 text-center text-3xl font-bold">Commercial Roofing FAQ</h2>
        <FAQ faqs={data.faqs} emitSchema={false} />
      </div>
    </section>
  )}

  <CTABanner
    heading={`Need a commercial roofing plan in ${data.name}?`}
    subtitle="Send the roof size, building type, and timeline. We route it to the nearest Pro Exteriors team."
    ctaText="Start Commercial RFQ"
    ctaHref="/contact/commercial/"
  />
</BaseLayout>