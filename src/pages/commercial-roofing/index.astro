---
/* ──────────────────────────────────────────────────────────────────────────────
   Commercial Roofing — Consolidated Pillar Page
   Rebuilt 2026-05-27 by Maren Castellan-Reyes.
   Tasks 12 & 14: single consolidated page, no sub-pages for system types.
   Content sourced from Pro_Exteriors_Commercial_Services.docx.

   CONVERSION HYPOTHESIS:
     Replacing the prior multi-system grid with a property-type–led narrative
     and real named clients (TMS, Fort Worth ISD, Pottsboro ISD, TIPS) will
     lift commercial lead-form completions by ≥30% within 90 days vs. the
     pre-rebuild baseline.

   Author: Maren Castellan-Reyes · AIA4 Pro Exteriors
─────────────────────────────────────────────────────────────────────────────── */

import BaseLayout from '../../components/seo/BaseLayout.astro';
import Breadcrumb from '../../components/molecules/Breadcrumb.astro';
import FAQ from '../../components/molecules/FAQ.astro';
import OfficeLocationsMap from '../../components/islands/OfficeLocationsMap';
import Icon from '../../components/atoms/Icon.astro';
import { breadcrumbSchema } from '../../lib/schema/BreadcrumbList';
import { faqPageSchema } from '../../lib/schema/FAQPage';
import { serviceSchema } from '../../lib/schema/Service';

// ── Property types served ─────────────────────────────────────────────────────
const propertyTypes = [
  { icon: 'building-2',   label: 'Multi-Building Apartment Communities' },
  { icon: 'home',         label: 'HOA-Managed Portfolios' },
  { icon: 'briefcase',    label: 'Corporate Office Campuses & Class A Office' },
  { icon: 'heart-pulse',  label: 'Healthcare & Medical Facilities' },
  { icon: 'hotel',        label: 'Hospitality & Lodging Properties' },
  { icon: 'church',       label: 'Faith-Based & Ecclesiastical Campuses' },
  { icon: 'graduation-cap', label: 'Higher Education & K–12 Districts' },
  { icon: 'landmark',     label: 'Municipal & Government Facilities' },
  { icon: 'factory',      label: 'Industrial & Manufacturing Facilities' },
  { icon: 'package',      label: 'Distribution Centers & Logistics Hubs' },
  { icon: 'store',        label: 'Mixed-Use & Retail Developments' },
  { icon: 'globe',        label: 'National Commercial Real Estate Portfolios' },
];

// ── Divisions ─────────────────────────────────────────────────────────────────
const divisions = [
  {
    name: 'Commercial Division',
    body: 'Low-slope reroofs, metal roofing systems, capital improvement programs, and complex exterior renovations.',
    icon: 'building-2',
  },
  {
    name: 'Multifamily Division',
    body: 'Portfolio-level coordination for apartment communities, HOAs, and multi-building assets.',
    icon: 'home',
  },
  {
    name: 'Service & Asset Management Division',
    body: 'Preventative maintenance, leak diagnostics, emergency response, lifecycle planning, and long-term asset preservation.',
    icon: 'shield',
  },
  {
    name: 'National Business Development Division',
    body: 'Strategic partnerships, multi-state account management, and institutional portfolio coordination.',
    icon: 'globe',
  },
];

// ── Low-slope manufacturer logos (Task 14/28) ─────────────────────────────────
const lowSlopeLogos = [
  { file: 'Elevate_logo_stacked_gradient_CMYK.webp', name: 'Carlisle / Elevate',    alt: 'Carlisle Elevate logo — certified commercial roofing installer' },
  { file: 'FiberTite_Only (500px wide)-1.webp',     name: 'FiberTite',             alt: 'FiberTite logo — certified commercial membrane installer' },
  { file: 'Duro-Last-Logo.webp',                     name: 'Duro-Last',             alt: 'Duro-Last logo — certified installer' },
  { file: 'so4677sc9a-soprema-logo-soprema-logo-01-gridworx-wall-systems.webp', name: 'SOPREMA', alt: 'SOPREMA logo — certified commercial roofing applicator' },
  { file: 'nav-logo.webp',                           name: 'Mule-Hide',             alt: 'Mule-Hide Products logo — certified installer' },
  { file: 'TRP_Logo_3.webp',                        name: 'Tropical Roofing Products', alt: 'Tropical Roofing Products logo — certified fluid-applied applicator' },
];

const metalLogos = [
  { file: 'mcelroymetal-logo-100w.webp', name: 'McElroy Metal',          alt: 'McElroy Metal logo — certified standing seam installer' },
  { file: 'Sentrigard-Logo.webp',        name: 'Sentrigard Metal Roofing', alt: 'Sentrigard Metal Roofing Systems logo — certified installer' },
];

// ── Commercial FAQ ────────────────────────────────────────────────────────────
const faqs = [
  {
    question: 'How long does a commercial roof replacement typically take?',
    answer: 'Timelines vary by facility size and system type. A typical 50,000 sq. ft. warehouse re-roof runs two to three weeks once tear-off and weather windows are factored in. We commit to a guaranteed phased schedule during the assessment so building operations can continue during work.',
  },
  {
    question: 'What does a commercial roof cost per square foot?',
    answer: 'Installed cost on a low-slope commercial roof typically runs $4–$12/sq ft for single-ply membrane systems and $16–$22 for standing-seam metal panels. The spread is driven by tear-off scope, insulation R-value, deck condition, attachment method, and penetration count. The executive assessment delivers a per-square-foot range against your specific facility.',
  },
  {
    question: 'What is an NDL warranty and why do I need it?',
    answer: 'An NDL (No Dollar Limit) warranty is the manufacturer\'s commitment to repair or replace your roofing system without a financial cap through the warranty term — typically 20–30 years on commercial single-ply systems. NDL coverage is only available through manufacturer-certified installers. Every certified system Pro Exteriors installs qualifies for NDL coverage from the respective manufacturer.',
  },
  {
    question: 'Can you perform work without interrupting our business operations?',
    answer: 'Yes. Phased off-hours installation is standard practice on our commercial portfolio. Our hot-air welded TPO seams produce no fumes, making daytime adjacent work feasible on retail and multi-tenant properties. For 24/7 operations, we sequence tear-off and install in zones that follow the building\'s operational rhythm. The phasing plan is part of the executive assessment deliverable.',
  },
  {
    question: 'Do you work in multiple states?',
    answer: 'Pro Exteriors LLC is fully licensed, bonded, and insured in every state in which we operate. Our National Business Development Division manages multi-state portfolios and institutional accounts across markets. Contact us to confirm coverage in your specific state.',
  },
];

// ── Schema ────────────────────────────────────────────────────────────────────
const mainSchema = [
  breadcrumbSchema([
    { label: 'Home',               href: '/' },
    { label: 'Commercial Roofing', href: '/commercial-roofing/' },
  ]),
  serviceSchema({
    name: 'Multifamily & Commercial Exterior Contractor Services',
    description: 'National commercial and multifamily exterior contractor. Certified installers for low-slope membrane, metal, and fluid-applied systems. Serving institutional portfolios, K–12 districts, healthcare, hospitality, and government facilities.',
    url: 'https://proexteriorsus.com/commercial-roofing/',
  }),
  faqPageSchema(faqs),
];
---

<BaseLayout
  title="Multifamily & Commercial Roofing Contractor | Pro Exteriors"
  description="National commercial and multifamily exterior contractor. Certified for Carlisle, FiberTite, Duro-Last, McElroy Metal, and more. Institutional discipline at portfolio scale."
  canonicalPath="/commercial-roofing/"
  jsonLd={mainSchema}
>

  <!-- ════════════════════════════════════════════════════════════════════════
       BREADCRUMB
  ════════════════════════════════════════════════════════════════════════════ -->
  <div class="bg-stone-50 px-6 lg:px-8 py-4 border-b border-stone-200">
    <div class="max-w-7xl mx-auto">
      <Breadcrumb items={[
        { label: 'Home',               href: '/' },
        { label: 'Commercial Roofing', href: '/commercial-roofing/' },
      ]} />
    </div>
  </div>

  <!-- ════════════════════════════════════════════════════════════════════════
       HERO — dark navy, institutional copy
  ════════════════════════════════════════════════════════════════════════════ -->
  <section
    class="relative flex items-center overflow-hidden"
    style="min-height: 600px; height: calc(100vh - 80px); max-height: 870px; background-color: #11133F;"
    aria-label="Commercial roofing hero"
  >
    <div class="absolute inset-0">
      <picture>
        <source srcset="/images/clients/commercial/tpo-1.webp" type="image/webp" />
        <img
          src="/images/clients/commercial/tpo-1.webp"
          alt="Pro Exteriors crew on a completed commercial low-slope roofing project"
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
      <div class="absolute inset-0" style="background: linear-gradient(135deg, rgba(17,19,63,0.92) 0%, rgba(17,19,63,0.75) 60%, rgba(17,19,63,0.50) 100%);"></div>
    </div>

    <div class="relative z-10 w-full max-w-7xl mx-auto px-6 lg:px-8">
      <div class="max-w-3xl flex flex-col gap-6">
        <span class="inline-flex w-fit px-3 py-1 text-white text-xs font-bold uppercase tracking-widest" style="background-color: #C22326;">
          Official Roofing Partner · Texas Motor Speedway
        </span>
        <h1 class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black text-white leading-tight tracking-tight">
          Multifamily &amp; Commercial Services
        </h1>
        <p class="text-xl md:text-2xl font-light text-white/80 leading-snug max-w-2xl">
          National Infrastructure. Institutional Discipline. Asset-Level Protection.
        </p>
        <p class="text-base md:text-lg text-white/70 leading-relaxed max-w-2xl">
          Pro Exteriors LLC is a national commercial and multifamily exterior contractor
          engineered for institutional execution — division-based infrastructure, multi-state
          licensing, and long-term asset protection strategies.
        </p>
        <div class="flex flex-wrap gap-4 pt-4">
          <a
            href="/contact/"
            class="inline-flex items-center justify-center px-8 py-4 text-white text-lg font-bold rounded transition-colors focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-offset-[#11133F]"
            style="background-color: #C22326;"
            onmouseover="this.style.backgroundColor='#a01e20'"
            onmouseout="this.style.backgroundColor='#C22326'"
            data-event-name="cta_click"
            data-event-cta-id="hero_schedule_assessment"
          >
            Schedule Commercial Assessment
          </a>
          <a
            href="tel:+18663367767"
            class="inline-flex items-center justify-center px-8 py-4 bg-transparent hover:bg-white/10 text-white text-lg font-bold rounded border-2 border-white transition-colors focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-[#11133F]"
            data-event-name="cta_click"
            data-event-cta-id="hero_phone"
          >
            866-336-PROS
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════════
       INTRO — from the client doc
  ════════════════════════════════════════════════════════════════════════════ -->
  <section class="bg-white py-20 px-6 lg:px-8" aria-labelledby="intro-heading">
    <div class="max-w-4xl mx-auto flex flex-col gap-8">
      <h2 id="intro-heading" class="text-3xl md:text-4xl font-black text-slate-900 leading-tight">
        Institutional Experience. Portfolio-Level Capability.
      </h2>
      <div class="text-lg text-slate-600 leading-relaxed space-y-5">
        <p>
          Pro Exteriors LLC is a national commercial and multifamily exterior contractor
          engineered for institutional execution. We operate through a structured, division-based
          infrastructure designed to support multi-state portfolios, institutional campuses,
          municipal facilities, and large-scale multifamily communities with precision and
          accountability.
        </p>
        <p>
          Fully licensed, bonded, and insured in every state in which we operate, we provide
          regulatory compliance, risk mitigation, and structured delivery across every project lifecycle.
        </p>
        <p>
          We do not approach projects as isolated roof replacements. We approach them as
          long-term asset protection strategies.
        </p>
        <p>
          Commercial and multifamily properties demand operational discipline, documentation
          integrity, safety compliance, and scalable coordination. Our teams understand
          occupied-property logistics, phased capital improvement planning, institutional
          procurement standards, and multi-layer reporting requirements.
        </p>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════════
       PROPERTY TYPES SERVED — icon card grid
  ════════════════════════════════════════════════════════════════════════════ -->
  <section class="bg-stone-100 py-20 px-6 lg:px-8" aria-labelledby="property-types-heading">
    <div class="max-w-7xl mx-auto flex flex-col gap-12">
      <header class="text-center max-w-2xl mx-auto">
        <h2 id="property-types-heading" class="text-3xl md:text-4xl font-black text-slate-900">
          Properties We Protect
        </h2>
        <p class="mt-4 text-lg text-slate-600">
          From Class A office campuses to national logistics portfolios — our teams are
          equipped for the full spectrum of commercial and multifamily property types.
        </p>
      </header>
      <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-4" role="list">
        {propertyTypes.map((pt) => (
          <li class="bg-white rounded-lg p-6 flex flex-col items-center text-center gap-3 shadow-sm hover:shadow-md transition-shadow">
            <div class="w-12 h-12 rounded-full flex items-center justify-center" style="background-color: #11133F;">
              <Icon name={pt.icon} size={22} class="text-white" strokeWidth={2} />
            </div>
            <p class="text-sm font-semibold text-slate-800 leading-snug">{pt.label}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════════
       TRUSTED PARTNERSHIPS — named clients
  ════════════════════════════════════════════════════════════════════════════ -->
  <section class="py-16 text-white" style="background-color: #11133F;" aria-labelledby="trusted-heading">
    <div class="w-[90%] mx-auto text-center">
      <p class="text-white/60 text-xs uppercase tracking-widest mb-8">Trusted By</p>
      <div class="flex flex-wrap justify-center gap-8 items-center">
        <span class="text-white font-bold text-lg">Texas Motor Speedway</span>
        <span class="text-white/40">·</span>
        <span class="text-white font-bold">Fort Worth ISD</span>
        <span class="text-white/40">·</span>
        <span class="text-white font-bold">Pottsboro ISD</span>
        <span class="text-white/40">·</span>
        <span class="text-white font-bold">TIPS Cooperative Purchasing Program</span>
      </div>
      <p class="mt-6 text-white/50 text-sm">Including South Georgia State College · Paine College</p>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════════
       DIVISIONS — four-column cards
  ════════════════════════════════════════════════════════════════════════════ -->
  <section class="bg-white py-20 px-6 lg:px-8" aria-labelledby="divisions-heading">
    <div class="max-w-7xl mx-auto flex flex-col gap-12">
      <header class="max-w-2xl">
        <h2 id="divisions-heading" class="text-3xl md:text-4xl font-black text-slate-900 leading-tight">
          Structured Divisions. Corporate-Level Oversight.
        </h2>
        <p class="mt-4 text-lg text-slate-600">
          Our internal structure ensures disciplined execution at scale. This infrastructure
          allows consistent standards across markets while maintaining centralized accountability.
        </p>
      </header>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" role="list">
        {divisions.map((div) => (
          <li class="border border-stone-200 rounded-xl p-8 flex flex-col gap-4 hover:border-[#C22326] transition-colors">
            <div class="w-12 h-12 rounded-lg flex items-center justify-center" style="background-color: #11133F;">
              <Icon name={div.icon} size={22} class="text-white" strokeWidth={2} />
            </div>
            <h3 class="text-lg font-bold text-slate-900">{div.name}</h3>
            <p class="text-sm text-slate-600 leading-relaxed">{div.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════════
       ROOFING SYSTEMS WE INSTALL — real client project photography by type
  ════════════════════════════════════════════════════════════════════════════ -->
  <section class="bg-stone-50 py-20 px-6 lg:px-8" aria-labelledby="systems-heading">
    <div class="max-w-7xl mx-auto flex flex-col gap-12">
      <header class="max-w-2xl">
        <h2 id="systems-heading" class="text-3xl md:text-4xl font-black text-slate-900 leading-tight">
          Commercial Roofing Systems We Install
        </h2>
        <p class="mt-4 text-lg text-slate-600">
          Real Pro Exteriors projects across every commercial assembly — from low-slope
          single-ply to standing-seam metal and steep-slope systems.
        </p>
      </header>
      <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6" role="list">
        {[
          { type: 'TPO', img: '/images/clients/commercial/tpo-2.webp', body: 'Hot-air welded TPO single-ply membrane for low-slope commercial roofs — energy-efficient, seamless, and installable with no fumes on occupied buildings.' },
          { type: 'EPDM', img: '/images/clients/commercial/epdm-1.webp', body: 'Durable EPDM single-ply membrane engineered for long-service-life low-slope assemblies on warehouses, distribution centers, and institutional facilities.' },
          { type: 'Metal', img: '/images/clients/commercial/metal-1.webp', body: 'Architectural and standing-seam metal systems — certified installation of McElroy Metal and Sentrigard, with weathertightness warranties on qualifying systems.' },
          { type: 'Shingles', img: '/images/clients/commercial/shingles-1.webp', body: 'Commercial steep-slope shingle systems — certified with Malarkey, Atlas, and GAF for multifamily, hospitality, and faith-based campuses.' },
        ].map((s) => (
          <li class="bg-white rounded-xl overflow-hidden shadow-sm flex flex-col">
            <img src={s.img} alt={`Pro Exteriors commercial ${s.type} roofing project`} class="w-full h-48 object-cover" loading="lazy" />
            <div class="p-6 flex flex-col gap-2">
              <h3 class="text-lg font-bold text-slate-900">{s.type}</h3>
              <p class="text-sm text-slate-600 leading-relaxed">{s.body}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════════
       MULTIFAMILY — dedicated section with client project photography
  ════════════════════════════════════════════════════════════════════════════ -->
  <section class="bg-white py-20 px-6 lg:px-8" aria-labelledby="multifamily-heading">
    <div class="max-w-7xl mx-auto flex flex-col gap-12">
      <header class="max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-widest mb-3" style="color: #C22326;">Multifamily Division</p>
        <h2 id="multifamily-heading" class="text-3xl md:text-4xl font-black text-slate-900 leading-tight">
          Multifamily Communities, Coordinated at Portfolio Scale
        </h2>
        <p class="mt-4 text-lg text-slate-600 leading-relaxed">
          Portfolio-level coordination for apartment communities, HOAs, and multi-building
          assets. We manage occupied-property logistics, phased capital improvement planning,
          and multi-layer reporting across entire multifamily portfolios — protecting residents
          and asset value at the same time.
        </p>
      </header>
      <ul class="grid grid-cols-2 lg:grid-cols-4 gap-4" role="list">
        {[
          '/images/clients/multifamily/mf-1.webp',
          '/images/clients/multifamily/mf-2.webp',
          '/images/clients/multifamily/mf-3.webp',
          '/images/clients/multifamily/mf-4.webp',
        ].map((img, i) => (
          <li>
            <img src={img} alt={`Pro Exteriors multifamily roofing project ${i + 1}`} class="w-full aspect-square object-cover rounded-lg" loading="lazy" />
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════════
       CERTIFIED MANUFACTURER SYSTEMS — Tasks 14 & 28
  ════════════════════════════════════════════════════════════════════════════ -->
  <section class="bg-stone-50 py-20 px-6 lg:px-8 border-y border-stone-200" aria-labelledby="certs-heading">
    <div class="max-w-7xl mx-auto flex flex-col gap-16">
      <header class="text-center max-w-2xl mx-auto">
        <p class="text-xs font-bold uppercase tracking-widest mb-3" style="color: #C22326;">Certified &amp; Authorized Installation Partners</p>
        <h2 id="certs-heading" class="text-3xl md:text-4xl font-black text-slate-900 leading-tight">
          Engineered Roofing &amp; Restoration Systems
        </h2>
        <p class="mt-4 text-lg text-slate-600">
          Every system we install is backed by manufacturer certification — which means we can
          offer NDL (No Dollar Limit) warranties that uncertified contractors simply cannot provide.
        </p>
      </header>

      <!-- Low-Slope Certified Systems -->
      <div class="flex flex-col gap-8">
        <h3 class="text-xl font-bold text-slate-900 border-b border-stone-200 pb-4">Low-Slope Certified Systems</h3>
        <ul class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-6 items-center" role="list">
          {lowSlopeLogos.map((logo) => (
            <li class="flex items-center justify-center bg-white rounded-lg p-4 shadow-sm h-24">
              <img
                src={`/images/partners/${logo.file}`}
                alt={logo.alt}
                class="max-h-14 max-w-full object-contain"
                loading="lazy"
              />
            </li>
          ))}
        </ul>
      </div>

      <!-- Metal & Steep-Slope Systems -->
      <div class="flex flex-col gap-8">
        <h3 class="text-xl font-bold text-slate-900 border-b border-stone-200 pb-4">Metal &amp; Steep-Slope Systems</h3>
        <ul class="grid grid-cols-2 sm:grid-cols-4 gap-6 items-center max-w-2xl" role="list">
          {metalLogos.map((logo) => (
            <li class="flex items-center justify-center bg-white rounded-lg p-4 shadow-sm h-24">
              <img
                src={`/images/partners/${logo.file}`}
                alt={logo.alt}
                class="max-h-14 max-w-full object-contain"
                loading="lazy"
              />
            </li>
          ))}
          <!-- Steep-slope certifications: Malarkey, Atlas, GAF (text badges) -->
          <li class="flex items-center justify-center bg-white rounded-lg p-4 shadow-sm h-24">
            <img
              src="/images/partners/malarkeylogo.webp"
              alt="Malarkey Roofing Products — certified installer"
              class="max-h-14 max-w-full object-contain"
              loading="lazy"
            />
          </li>
          <li class="flex items-center justify-center bg-white rounded-lg p-4 shadow-sm h-24">
            <img
              src="/images/partners/GAF-Logo_800x400.webp"
              alt="GAF — certified commercial installer"
              class="max-h-14 max-w-full object-contain"
              loading="lazy"
            />
          </li>
        </ul>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════════
       GOVERNANCE & WARRANTIES
  ════════════════════════════════════════════════════════════════════════════ -->
  <section class="bg-white py-20 px-6 lg:px-8" aria-labelledby="warranty-heading">
    <div class="max-w-7xl mx-auto grid gap-12 lg:grid-cols-2 items-center">
      <div>
        <h2 id="warranty-heading" class="text-3xl md:text-4xl font-black text-slate-900 leading-tight">
          Governance, Warranty &amp; Risk Mitigation
        </h2>
        <p class="mt-6 text-lg text-slate-600 leading-relaxed">
          Every project is supported by a complete governance framework — not just a warranty
          card. We document, report, and manage accountability from mobilization through
          final sign-off.
        </p>
      </div>
      <ul class="space-y-4" role="list">
        {[
          'Manufacturer-backed system warranties',
          'Weathertightness warranties on qualifying metal systems',
          'Five-year workmanship warranty',
          'Structured quality control protocols',
          'Comprehensive documentation and reporting',
          'Dedicated project management leadership',
        ].map((item) => (
          <li class="flex items-start gap-3">
            <div class="w-6 h-6 rounded-full flex-shrink-0 flex items-center justify-center mt-0.5" style="background-color: #C22326;">
              <Icon name="check" size={12} class="text-white" strokeWidth={3} />
            </div>
            <span class="text-base text-slate-700 leading-relaxed">{item}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════════════════
       NATIONWIDE REACH — map
  ════════════════════════════════════════════════════════════════════════════ -->
