---
import BaseLayout from '../components/seo/BaseLayout.astro';
import { websiteSchema } from '../lib/schema/WebSite';
import { organizationSchema } from '../lib/schema/Organization';
import OfficeLocationsMap from '../components/islands/OfficeLocationsMap';
import Icon from '../components/atoms/Icon.astro';

// ── Schema ────────────────────────────────────────────────────────────────────
const mainSchema = [websiteSchema(), organizationSchema()];
---

<BaseLayout
  title="Pro Exteriors | Commercial & Residential Roofing — 16 States"
  description="Institutional-grade roofing for commercial procurement and dedicated care for residential homeowners across 16 states. Local crews. Engineering-grade results."
  canonicalPath="/"
  jsonLd={mainSchema}
>

  <!-- ══════════════════════════════════════════════════════════════════════════
       HERO — full-bleed video/image hybrid, bifurcated CTAs
  ══════════════════════════════════════════════════════════════════════════════ -->
  <section
    class="relative flex items-center overflow-hidden"
    style="height: calc(100vh - 80px); min-height: 600px; max-height: 870px;"
    aria-label="Homepage hero"
  >
    <div class="absolute inset-0">
      <!-- Poster loads instantly; video loops silently after page load -->
      <img
        id="hero-poster"
        src="/images/tms-hero-poster.webp"
        alt=""
        class="w-full h-full object-cover"
        loading="eager"
        fetchpriority="high"
      />
      <video
        id="hero-video"
        autoplay
        muted
        loop
        playsinline
        class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-1000"
        aria-hidden="true"
      >
        <source src="/videos/tms-hero.mp4" type="video/mp4" />
      </video>
      <div class="absolute inset-0 bg-slate-900/70"></div>
    </div>

    <script>
      const video = document.getElementById('hero-video') as HTMLVideoElement | null;
      const poster = document.getElementById('hero-poster') as HTMLImageElement | null;
      if (video && poster) {
        video.addEventListener('canplay', () => {
          video.style.opacity = '1';
        }, { once: true });
      }
    </script>

    <div class="relative z-10 w-[90%] mx-auto">
      <div class="max-w-3xl flex flex-col gap-6">

        <p class="font-serif italic text-white/80 text-lg tracking-wide">#BuiltOnFaith</p>

        <!-- Task 21 new H1 -->
        <h1 class="text-5xl md:text-6xl lg:text-7xl font-bold text-white leading-tight tracking-tight -mt-2">
          America's Top Commercial Roofing Company
        </h1>

        <!-- Task 21 updated subheadline -->
        <p class="text-xl md:text-2xl text-white/90 leading-relaxed max-w-2xl">
          Institutional-grade performance for commercial facilities, multifamily
          portfolios, and residential homeowners across 16 states.
        </p>

        <div class="flex flex-wrap gap-4 pt-4">
          <a
            href="/commercial-roofing/"
            class="inline-flex items-center justify-center px-8 py-4 bg-red-700 hover:bg-red-800 text-white text-lg font-bold rounded transition-colors focus:outline-none focus:ring-2 focus:ring-red-400 focus:ring-offset-2 focus:ring-offset-slate-900"
            data-cta-name="hero_commercial"
          >
            Commercial Solutions
          </a>
          <a
            href="/residential-roofing/"
            class="inline-flex items-center justify-center px-8 py-4 bg-transparent hover:bg-white/10 text-white text-lg font-bold rounded border-2 border-white transition-colors focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-slate-900"
            data-cta-name="hero_residential"
          >
            Residential Services
          </a>
        </div>

        <!-- Task 2 Trust / Honor / Integrity boxes -->
        <div class="flex flex-wrap gap-6 pt-6 border-t border-white/20 mt-2">
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-white flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
            </svg>
            <span class="text-white font-bold text-sm">Trust</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-white flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
            </svg>
            <span class="text-white font-bold text-sm">Honor</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-white flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
            </svg>
            <span class="text-white font-bold text-sm">Integrity</span>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       CLIENT VOICES — moved to second position per Task 22
  ══════════════════════════════════════════════════════════════════════════════ -->
  <section class="bg-[#C22326] py-24" aria-labelledby="testimonial-heading">
    <div class="w-[90%] mx-auto flex flex-col items-center gap-12">
      <h2 id="testimonial-heading" class="text-3xl font-black text-white uppercase tracking-[0.2em]">Client Voices</h2>

      <!-- Task 8: rounded-2xl, p-14, border-l-4, white card on red background -->
      <figure class="relative w-full max-w-3xl bg-white text-slate-900 rounded-2xl p-14 flex flex-col gap-6 shadow-sm border-l-4 border-red-700">
        <!-- Decorative quote mark -->
        <div class="absolute top-8 left-8 text-slate-900/10" aria-hidden="true">
          <svg width="44" height="28" viewBox="0 0 44 28" fill="currentColor">
            <path d="M0 28V17.5C0 7.833 5.167 2.167 15.5 0l2 3.5C12.167 5.167 9.5 8.5 9.5 14H18V28H0zm26 0V17.5C26 7.833 31.167 2.167 41.5 0l2 3.5C38.167 5.167 35.5 8.5 35.5 14H44V28H26z"/>
          </svg>
        </div>

        <div class="flex items-center justify-center gap-1">
          {[0,1,2,3,4].map(() => (
            <svg class="w-5 h-5 fill-orange-500" viewBox="0 0 20 20" aria-hidden="true">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
        </div>

        <blockquote class="text-center text-2xl font-medium text-slate-900 leading-relaxed">
          "In the commercial world, responsiveness is everything. Pro Exteriors
          not only fixed our immediate leaks but provided a 5-year maintenance
          strategy that finally gave us budget predictability."
        </blockquote>

        <figcaption class="flex items-center justify-center gap-4 pt-2">
          <div class="w-16 h-16 rounded-xl bg-slate-200 overflow-hidden flex-shrink-0 flex items-center justify-center text-slate-600 font-bold text-xl">
            M
          </div>
          <div>
            <div class="font-bold text-slate-900">Marcus Thorne</div>
            <div class="text-slate-600 text-sm">Director of Facilities, Southwest Logistics</div>
          </div>
        </figcaption>
      </figure>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       STATS BAND — dark, 5 trust signals (third position)
  ══════════════════════════════════════════════════════════════════════════════ -->
  <section class="bg-slate-900 py-12" aria-label="Trust signals">
    <div class="w-[90%] mx-auto">
      <dl class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-8 text-center items-center">

        <!-- Faith Based — Pro Ministries (far left) -->
        <div class="flex flex-col items-center gap-2">
          <dt>
            <img
              src="/Logos/pro-ministries-logo-reverse.webp"
              alt="Pro Ministries — a faith-based organization"
              class="h-16 w-auto mx-auto"
              loading="lazy"
            />
          </dt>
          <dd class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Faith Based</dd>
        </div>

        <!-- Google 5-Star Rating -->
        <div class="flex flex-col items-center gap-1">
          <dt class="flex flex-col items-center gap-1">
            <span class="text-3xl font-bold text-white">5.0</span>
            <span class="flex items-center gap-0.5" aria-label="5 out of 5 stars">
              {[0,1,2,3,4].map(() => (
                <svg class="w-4 h-4 fill-orange-400" viewBox="0 0 20 20" aria-hidden="true">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </span>
          </dt>
          <dd class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Google Rating</dd>
        </div>

        <!-- Founding year -->
        <div class="flex flex-col items-center gap-1">
          <dt class="text-3xl font-bold text-white">2021</dt>
          <dd class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Roofing Since</dd>
        </div>

        <div class="flex flex-col items-center gap-1">
          <dt class="text-3xl font-bold text-white">16</dt>
          <dd class="text-xs font-semibold text-slate-400 uppercase tracking-widest">States Served</dd>
        </div>
        <div class="flex flex-col items-center gap-1 col-span-2 sm:col-span-1">
          <dt class="text-3xl font-bold text-white">2,500</dt>
          <dd class="text-xs font-semibold text-slate-400 uppercase tracking-widest">Roofs Protected</dd>
        </div>
      </dl>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       SERVICE DIVISIONS — Commercial / Residential / Roof Asset Management
       Three cards across, each routing into a division. Client photo backgrounds.
  ══════════════════════════════════════════════════════════════════════════════ -->
  <section class="bg-white py-24" aria-label="Service paths">
    <div class="w-[90%] mx-auto">
      <div class="grid md:grid-cols-3 gap-6">

        <!-- Commercial -->
        <div class="relative h-[500px] rounded-lg overflow-hidden bg-blue-950 flex items-end">
          <img
            src="/images/home/card-commercial.webp"
            alt="Pro Exteriors commercial roofing project"
            class="absolute inset-0 w-full h-full object-cover opacity-60"
            loading="lazy"
          />
          <div class="relative z-10 w-full p-10 bg-gradient-to-l from-slate-900 to-transparent flex flex-col gap-4">
            <h2 class="text-3xl font-bold text-white">Commercial &amp; Multifamily</h2>
            <p class="text-white/80 leading-relaxed max-w-sm pb-4">
              Asset management, maintenance, and large-scale replacements for
              facilities managers and institutional owners.
            </p>
            <a
              href="/commercial-roofing/"
              class="self-start inline-flex items-center justify-center px-6 py-3 bg-white text-slate-900 text-base font-bold rounded hover:bg-slate-100 transition-colors focus:outline-none focus:ring-2 focus:ring-white"
              data-cta-name="split_commercial"
            >
              Commercial Solutions
            </a>
          </div>
        </div>

        <!-- Residential -->
        <div class="relative h-[500px] rounded-lg overflow-hidden bg-blue-100 flex items-end">
          <img
            src="/images/home/card-residential.webp"
            alt="Pro Exteriors residential roofing project"
            class="absolute inset-0 w-full h-full object-cover opacity-60"
            loading="lazy"
          />
          <div class="relative z-10 w-full p-10 bg-gradient-to-l from-slate-700 to-transparent flex flex-col gap-4">
            <h2 class="text-3xl font-bold text-white">Residential Roofing</h2>
            <p class="text-white/80 leading-relaxed max-w-sm pb-4">
              Dedicated homeowner services focusing on durability, aesthetic
              appeal, and seamless insurance claim handling.
            </p>
            <a
              href="/residential-roofing/"
              class="self-start inline-flex items-center justify-center px-6 py-3 bg-white text-slate-900 text-base font-bold rounded hover:bg-slate-100 transition-colors focus:outline-none focus:ring-2 focus:ring-white"
              data-cta-name="split_residential"
            >
              Residential Services
            </a>
          </div>
        </div>

        <!-- Roof Asset Management -->
        <div class="relative h-[500px] rounded-lg overflow-hidden bg-slate-800 flex items-end">
          <img
            src="/images/home/card-roof-asset-management.webp"
            alt="Pro Exteriors roof asset management and maintenance"
            class="absolute inset-0 w-full h-full object-cover opacity-60"
            loading="lazy"
          />
          <div class="relative z-10 w-full p-10 bg-gradient-to-l from-slate-900 to-transparent flex flex-col gap-4">
            <h2 class="text-3xl font-bold text-white">Roof Asset Management</h2>
            <p class="text-white/80 leading-relaxed max-w-sm pb-4">
              Preventative maintenance, leak diagnostics, and lifecycle planning
              that protect your roof as a long-term asset.
            </p>
            <a
              href="/proplan/"
              class="self-start inline-flex items-center justify-center px-6 py-3 bg-white text-slate-900 text-base font-bold rounded hover:bg-slate-100 transition-colors focus:outline-none focus:ring-2 focus:ring-white"
              data-cta-name="split_asset_management"
            >
              Service &amp; Maintenance
            </a>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       FULL-SPECTRUM SERVICES — 6-card grid
       Task 4: bg-[#11133F] dark navy (was bg-stone-100), white text
  ══════════════════════════════════════════════════════════════════════════════ -->
  <section class="bg-[#11133F] py-24" aria-labelledby="services-heading">
    <div class="w-[90%] mx-auto flex flex-col gap-16">

      <div class="flex flex-col gap-4">
        <h2 id="services-heading" class="text-4xl font-bold text-white">Full-Spectrum Exterior Solutions</h2>
        <div class="w-20 h-1.5 bg-[#C22326] rounded-full"></div>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-white/10 rounded-lg overflow-hidden border border-white/10">
        {[
          {
            title: 'Roof Replacement',
            desc: 'End-to-end replacement using premium materials engineered for longevity and extreme weather resistance.',
            href: '/commercial-roofing/replacement/',
            icon: 'hammer',
          },
          {
            title: 'Emergency Repair',
            desc: '24/7 rapid response for storm damage and critical leaks to mitigate further property loss immediately.',
            href: '/commercial-roofing/repair/',
            icon: 'siren',
          },
          {
            title: 'Asset Management',
            desc: 'Strategic maintenance programs designed to extend the lifecycle of your roofing portfolio and reduce TCO.',
            href: '/proplan/',
            icon: 'line-chart',
          },
          {
            title: 'Design & Consulting',
            desc: 'Technical expertise for complex architectural challenges and new construction exterior specifications.',
            href: '/commercial-roofing/',
            icon: 'pencil-ruler',
          },
          {
            title: 'Siding & Gutters',
            desc: 'Comprehensive envelope protection including high-performance siding systems and custom drainage solutions.',
            href: '/contact/residential-roofing/inspection/',
            icon: 'layers',
          },
          {
            title: 'Inspections & Audits',
            desc: 'Detailed forensic inspections providing actionable data for real estate transactions or insurance needs.',
            href: '/contact/?intent=inspection',
            icon: 'search',
          },
        ].map((s) => (
          <div class="bg-white/5 p-8 flex flex-col gap-3 border border-white/10">
            <div class="w-10 h-10 bg-[#C22326] rounded-sm flex-shrink-0 flex items-center justify-center text-white" aria-hidden="true">
              <Icon name={s.icon} size={22} strokeWidth={2.25} />
            </div>
            <h3 class="text-xl font-bold text-white pt-3">{s.title}</h3>
            <p class="text-white/70 leading-relaxed text-base">{s.desc}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       TMS PARTNERSHIP CREDIBILITY BAND — replaces "Built for Every Property Type"
       service-nav as of 2026-05-28. See /decisions/2026-05-28-tms-partnership-
       replaces-property-nav.md for context, hypothesis, and rollback trigger.

       Hypothesis: Recognizable Texas brand partnership as a homepage credibility
       anchor will lift homepage-to-RFQ conversion more than the lost shortcut
       to service routes costs us. Measurement: 4-week window, GA4 + PostHog,
       event `homepage_tms_cta_click`. Rollback if direct service-route entries
       from homepage drop >15% vs 30-day baseline and don't recover in 2 weeks.

       Service routing for commercial / residential is still surfaced via the
       global header nav, the footer, and in-content links from the hero.
  ══════════════════════════════════════════════════════════════════════════════ -->
  <section
    class="relative overflow-hidden bg-[#11133f]"
    aria-label="Pro Exteriors and Texas Motor Speedway partnership"
  >
    <picture>
      <source srcset="/images/tms-partnership-section.webp" type="image/webp" />
      <img
        src="/images/tms-partnership-section.webp"
        alt="Pro Exteriors crew gathered in a job-site huddle, demonstrating the team standard that supports the company's partnership with Texas Motor Speedway."
        class="w-full h-auto block"
        width="1920"
        height="1080"
        loading="lazy"
        decoding="async"
      />
    </picture>

    <!-- Overlay link covers the section so the entire band is clickable into the
         partnership story. Keyboard users hit the same target via the visible CTA
         that the image already shows. -->
    <a
      href="https://pc-demo.cleverwork.io/commercial-roofing/"
      class="absolute inset-0 focus:outline-2 focus:outline-offset-[-4px] focus:outline-[#eaa221]"
      aria-label="See the Pro Exteriors and Texas Motor Speedway partnership"
      data-cta-name="homepage_tms_cta_click"
    >
      <span class="sr-only">See the Partnership</span>
    </a>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       CERTIFIED INSTALLATION PARTNERS — Task 6
  ══════════════════════════════════════════════════════════════════════════════ -->
  <section class="bg-white py-16 border-y border-stone-200" aria-label="Certified installation partners">
    <div class="w-[90%] mx-auto">
      <p class="text-center text-xs font-bold uppercase tracking-widest text-slate-500 mb-10">Certified &amp; Authorized Installation Partners</p>
      <div class="flex flex-wrap items-center justify-center gap-8 lg:gap-16">
        <img
          src="/images/partners/elevate.webp"
          alt="Elevate (formerly Carlisle SynTec) — certified installation partner"
          class="h-10 w-auto object-contain grayscale opacity-70 hover:opacity-100 hover:grayscale-0 transition-all"
          loading="lazy"
        />
        <img
          src="/images/partners/fibertite.webp"
          alt="FiberTite — certified installation partner"
          class="h-10 w-auto object-contain grayscale opacity-70 hover:opacity-100 hover:grayscale-0 transition-all"
          loading="lazy"
        />
        <img
          src="/images/partners/duro-last.webp"
          alt="Duro-Last — certified installation partner"
          class="h-10 w-auto object-contain grayscale opacity-70 hover:opacity-100 hover:grayscale-0 transition-all"
          loading="lazy"
        />
        <img
          src="/images/partners/soprema.webp"
          alt="SOPREMA — certified installation partner"
          class="h-10 w-auto object-contain grayscale opacity-70 hover:opacity-100 hover:grayscale-0 transition-all"
          loading="lazy"
        />
        <img
          src="/images/partners/mcelroy-metal.webp"
          alt="McElroy Metal — certified installation partner"
          class="h-10 w-auto object-contain grayscale opacity-70 hover:opacity-100 hover:grayscale-0 transition-all"
          loading="lazy"
        />
        <img
          src="/images/partners/sentrigard.webp"
          alt="Sentrigard — certified installation partner"
          class="h-10 w-auto object-contain grayscale opacity-70 hover:opacity-100 hover:grayscale-0 transition-all"
          loading="lazy"
        />
        <img
          src="/images/partners/gaf.webp"
          alt="GAF — certified installation partner"
          class="h-10 w-auto object-contain grayscale opacity-70 hover:opacity-100 hover:grayscale-0 transition-all"
          loading="lazy"
        />
        <img
          src="/images/partners/trp.webp"
          alt="TRP — certified installation partner"
          class="h-10 w-auto object-contain grayscale opacity-70 hover:opacity-100 hover:grayscale-0 transition-all"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       NATIONAL REACH — locations map (formatting mirrors /locations/)
  ══════════════════════════════════════════════════════════════════════════════ -->
  <section class="py-20 bg-surface-inset overflow-hidden" aria-labelledby="home-map-heading">
    <div class="w-[90%] mx-auto">
      <div class="text-center mb-12">
        <h2 id="home-map-heading" class="text-3xl font-bold">Where We Work</h2>
        <p class="text-text-secondary mt-4 text-lg">Click a pin to view office details and contact information.</p>
      </div>
      <!-- Desktop: card wrapper with legend -->
      <div class="hidden sm:block bg-surface-elevated p-4 rounded-3xl shadow-xl ring-1 ring-border">
        <OfficeLocationsMap title="" subtitle="" client:visible />
      </div>
      <!-- Mobile: compact map — no card, no legend, no padding, state labels visible -->
      <div class="block sm:hidden overflow-hidden rounded-lg">
        <OfficeLocationsMap showLegend={false} title="" subtitle="" compact={true} client:visible />
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════════════════════════════════════════════════
       WHY PRO EXTERIORS — 4 pillars
       Task 4: bg-white (was bg-stone-50)
       Task 31: Expertise copy updated
  ══════════════════════════════════════════════════════════════════════════════ -->
  <section class="bg-white py-24" aria-labelledby="pillars-heading">
    <div class="w-[90%] mx-auto">
      <h2 id="pillars-heading" class="sr-only">Why Pro Exteriors</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">

        <div class="flex flex-col gap-3">
          <div class="w-16 h-16 bg-slate-900 rounded-lg flex items-center justify-center flex-shrink-0">
            <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-stone-900 pt-3">Responsiveness</h3>
          <p class="text-slate-600 text-sm leading-relaxed">
            24-hour response window guaranteed. We understand that every minute of a
            leak costs your business or family.
          </p>
        </div>

        <div class="flex flex-col gap-3">
          <div class="w-16 h-16 bg-slate-900 rounded-lg flex items-center justify-center flex-shrink-0">
