---
/**
 * src/pages/projects/[slug]/index.astro
 * Case-study detail template (Step 8b).
 */
import { getCollection, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../../components/seo/BaseLayout.astro';
import HeroSection from '../../../components/molecules/HeroSection.astro';
import Breadcrumb from '../../../components/molecules/Breadcrumb.astro';
import { caseStudySchema } from '../../../lib/schema/CaseStudy';
import { breadcrumbSchema } from '../../../lib/schema/BreadcrumbList';

export async function getStaticPaths() {
  const studies = await getCollection('caseStudies');
  return studies.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

interface Props {
  entry: CollectionEntry<'caseStudies'>;
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const data = entry.data;

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Projects', href: '/projects/' },
  { label: data.projectName, href: data.canonicalPath },
];

const schemaPayload = [
  caseStudySchema({
    title: data.projectName,
    description: data.description,
    city: 'Texas',
    service: data.scope,
    url: `https://pc-demo.cleverwork.io${data.canonicalPath}`,
  }),
  breadcrumbSchema(breadcrumbs),
];

const poster = data.heroPoster ?? data.heroImage ?? '/images/commercial-hero.webp';
---

<BaseLayout
  title={data.title}
  description={data.description}
  canonicalPath={data.canonicalPath}
  jsonLd={schemaPayload}
>
  <Breadcrumb items={breadcrumbs.slice(1)} />

  {data.heroVideo ? (
    <!-- Video hero for projects that have a video asset -->
    <section
      class="relative flex items-end overflow-hidden"
      style="min-height: 520px; max-height: 700px; height: 60vh;"
      aria-label={`${data.projectName} hero`}
    >
      <div class="absolute inset-0">
        <img
          id="project-hero-poster"
          src={poster}
          alt=""
          class="w-full h-full object-cover"
          loading="eager"
          fetchpriority="high"
        />
        <video
          id="project-hero-video"
          autoplay
          muted
          loop
          playsinline
          class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-1000"
          aria-hidden="true"
        >
          <source src={data.heroVideo} type="video/mp4" />
        </video>
        <div class="absolute inset-0 bg-slate-900/65"></div>
      </div>

      <div class="relative z-10 w-[90%] mx-auto pb-14 pt-24">
        <span class="inline-block px-3 py-1 bg-[#C22326] text-white text-xs font-black uppercase tracking-widest rounded mb-4">
          {data.industryTag ?? data.industryCategory.toUpperCase()}
        </span>
        <h1 class="text-4xl md:text-6xl font-black text-white leading-tight mb-4">
          {data.projectName}
        </h1>
        <p class="text-white/80 text-lg md:text-xl max-w-2xl">{data.scope}</p>
        {data.stats && data.stats.length > 0 && (
          <dl class="flex flex-wrap gap-8 mt-8">
            {data.stats.map((stat) => (
              <div>
                <dt class="text-white/50 text-xs font-bold uppercase tracking-widest">{stat.label}</dt>
                <dd class="text-white text-2xl font-black mt-1">{stat.value}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>

      <script>
        const video = document.getElementById('project-hero-video') as HTMLVideoElement | null;
        if (video) {
          video.addEventListener('canplay', () => { video.style.opacity = '1'; }, { once: true });
        }
      </script>
    </section>
  ) : (
    <HeroSection
      title={data.projectName}
      subtitle={data.scope}
      image={poster}
    />
  )}

  <article class="prose mx-auto max-w-3xl px-4 py-16">
    <p class="text-text-tertiary italic mb-2">Industry: {data.industryCategory}</p>
    {data.timeline && <p class="text-text-tertiary italic mb-6">Timeline: {data.timeline}</p>}
    <Content />
    {data.testimonial && (
      <blockquote class="border-l-4 border-accent pl-4 italic text-text-secondary mt-8">
        "{data.testimonial}"
      </blockquote>
    )}
  </article>
</BaseLayout>
