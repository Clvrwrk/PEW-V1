---
import BaseLayout from '../../components/seo/BaseLayout.astro';
import HeroSection from '../../components/molecules/HeroSection.astro';
import Breadcrumb from '../../components/molecules/Breadcrumb.astro';
import LeadCaptureForm from '../../components/molecules/LeadCaptureForm.astro';
import { breadcrumbSchema } from '../../lib/schema/BreadcrumbList';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Total Home Shield', href: '/total-home-shield/' },
  { label: 'Booking', href: '/total-home-shield/booking/' },
];
const schemaPayload = [breadcrumbSchema(breadcrumbs)];
---

<BaseLayout
  title="Book Your Total Home Shield Onboarding | Pro Exteriors"
  description="Schedule your Pro Exteriors Total Home Shield onboarding call. Walk through annual coverage, scheduling, and your home's specific exterior plan."
  canonicalPath="/total-home-shield/booking/"
  noindex={true}
  jsonLd={schemaPayload}
>
  <Breadcrumb items={breadcrumbs.slice(1)} />
  <HeroSection
    image="/images/residential-hero.webp" title="Schedule Your Onboarding" subtitle="Pick a time. Our team will walk you through the annual coverage." />
  <section class="mx-auto max-w-3xl px-4 py-16">
    <h2 class="text-3xl font-bold mb-2 text-white">Request your onboarding call</h2>
    <p class="text-text-secondary mb-6">Tell us how to reach you and we'll schedule your Total Home Shield walkthrough — annual coverage, scheduling, and your home's specific exterior plan.</p>
    <LeadCaptureForm
      ctaId="ths-booking"
      source="Website – Total Home Shield Booking"
      intent="lead"
      propertyType="Residential"
      submitLabel="Request my onboarding call"
    />
    <p class="mt-8 text-text-secondary text-sm">While you wait: <a href="/projects/" class="text-accent hover:underline">recent projects</a> · <a href="/about/" class="text-accent hover:underline">meet the team</a>.</p>
  </section>
</BaseLayout>
