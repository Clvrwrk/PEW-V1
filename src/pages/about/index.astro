---
import BaseLayout from '../../components/seo/BaseLayout.astro';
import Breadcrumb from '../../components/molecules/Breadcrumb.astro';
import { aboutPageSchema } from '../../lib/schema/AboutPage';
import { breadcrumbSchema } from '../../lib/schema/BreadcrumbList';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'About Us', href: '/about/' },
];

const schemaPayload = [aboutPageSchema(), breadcrumbSchema(breadcrumbs)];

const coreValues = [
  { letter: 'F', name: 'Faith', body: 'We openly acknowledge our dependence on God and seek to honor Him in our decisions, conduct, and leadership.' },
  { letter: 'I', name: 'Integrity', body: 'We are committed to honesty, accountability, and doing what is right — especially when no one is watching.' },
  { letter: 'T', name: 'Trust', body: 'We build long-term relationships by delivering on our promises and stewarding the confidence placed in us by our clients, partners, and community.' },
  { letter: 'E', name: 'Excellence', body: 'We pursue the highest standards in craftsmanship, service, and professionalism, continually improving our processes and performance.' },
  { letter: 'S', name: 'Servant Leadership', body: 'We lead by serving — empowering our team, supporting our partners, and investing in the communities where we live and work.' },
];

const differentiators = [
  { title: 'Values-Driven Leadership', body: 'As a Christian-based company, our decisions and operations are guided by trust, honor, and integrity. These principles shape how we lead, serve, and follow through — on every project, every time.' },
  { title: 'Commitment to Transparency', body: 'We believe clear communication builds confidence. From initial inspections to project completion, we provide honest assessments, realistic timelines, and straightforward expectations — no surprises.' },
  { title: 'Quality Without Compromise', body: 'Our team is committed to delivering high standards of craftsmanship and attention to detail. We take pride in doing the job right and standing behind our work.' },
  { title: 'Accountability at Every Level', body: 'We take ownership of our work and our responsibilities. Our systems, processes, and leadership ensure consistency, reliability, and follow-through.' },
  { title: 'Community-Focused Mindset', body: 'We view our work as more than construction. By investing in people and operating with purpose, we aim to make a positive, lasting impact in the communities we serve.' },
];
---

<BaseLayout
  title="About Pro Exteriors | Built on Faith, Driven by Excellence"
  description="Pro Exteriors LLC is a Christian-values exterior contractor serving commercial and residential clients nationwide. Founded on trust, honor, and integrity."
  canonicalPath="/about/"
  jsonLd={schemaPayload}
>
  <Breadcrumb items={breadcrumbs.slice(1)} />

  <!-- ─── HERO ────────────────────────────────────────────────────────────── -->
  <section class="bg-[#11133F] text-white py-24 px-4">
    <div class="max-w-4xl mx-auto text-center">
      <p class="text-sm font-semibold tracking-widest uppercase text-[#C22326] mb-4">About Pro Exteriors LLC</p>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-bold leading-tight mb-6 text-white">
        Built on Faith.<br />Driven by Excellence.
      </h1>
      <p class="text-lg sm:text-xl text-white/80 max-w-2xl mx-auto mb-10 leading-relaxed">
        We are Pro Exteriors LLC — a national commercial and residential exterior contractor built on the principles of trust, honor, and integrity. Every project we take on is an extension of who we are.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a
          href="#mission"
          class="inline-flex items-center justify-center px-8 py-3 bg-[#C22326] text-white font-semibold rounded-lg hover:bg-[#a81e20] transition-colors"
          data-cta-name="about_hero_mission"
        >
          Our Mission
        </a>
        <a
          href="/team/"
          class="inline-flex items-center justify-center px-8 py-3 border border-white/40 text-white font-semibold rounded-lg hover:bg-white/10 transition-colors"
          data-cta-name="about_hero_team"
        >
          Meet the Team <span aria-hidden="true" class="ml-1">→</span>
        </a>
      </div>
    </div>
  </section>

  <!-- ─── OUR STORY ───────────────────────────────────────────────────────── -->
  <section class="bg-white py-24 px-4">
    <div class="max-w-4xl mx-auto">
      <p class="text-sm font-semibold tracking-widest uppercase text-[#C22326] mb-4 text-center">Our Story</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-[#11133F] text-center mb-12">Founded on Trust, Integrity, and Excellence</h2>
      <p class="text-base sm:text-lg text-slate-700 leading-relaxed mb-6">
        Pro Exteriors, LLC was founded on the belief that construction should be built on trust, integrity, and excellence. In an industry where those values can be inconsistent, we set out to create a company that leads with honesty, accountability, and quality craftsmanship.
      </p>
      <p class="text-base sm:text-lg text-slate-700 leading-relaxed">
        Guided by our Christian faith, we approach every project as an opportunity to serve people well and honor our commitments. Our focus is on building lasting relationships, delivering exceptional results, and operating with purpose in everything we do.
      </p>
    </div>
  </section>

  <!-- ─── MISSION & VISION ────────────────────────────────────────────────── -->
  <section id="mission" class="bg-stone-50 py-24 px-4">
    <div class="max-w-4xl mx-auto">
      <div class="grid md:grid-cols-2 gap-6 mb-12">
        <div class="bg-white rounded-2xl p-8 ring-1 ring-stone-200">
          <h2 class="text-2xl font-bold text-[#11133F] mb-4">Our Mission</h2>
          <p class="text-slate-700 leading-relaxed">
            Pro Exteriors, LLC exists to deliver exceptional construction services while operating with trust, honor, and integrity in every relationship. As a Christian-based organization, we are committed to excellence, ethical leadership, and serving our community through meaningful partnerships that extend our impact beyond the jobsite.
          </p>
        </div>
        <div class="bg-white rounded-2xl p-8 ring-1 ring-stone-200">
          <h2 class="text-2xl font-bold text-[#11133F] mb-4">Our Vision</h2>
          <p class="text-slate-700 leading-relaxed">
            To positively transform communities and elevate the culture of the construction industry by demonstrating servant leadership, operational excellence, and the life-changing power of the Gospel. Through strategic partnerships with Christian nonprofit organizations such as Men &amp; Ladies of Honor and CareCenter Ministries, we seek to influence lives, strengthen families, and model a higher standard of purpose-driven business.
          </p>
        </div>
      </div>

      <!-- Core values banner -->
      <div class="bg-[#11133F] rounded-2xl px-8 py-6 text-center">
        <p class="text-2xl sm:text-3xl font-bold text-white tracking-wide">
          Trust.&nbsp;&nbsp;Honor.&nbsp;&nbsp;Integrity.
        </p>
        <p class="text-white/60 text-sm mt-2 tracking-widest uppercase">Our Core Values</p>
      </div>
    </div>
  </section>

  <!-- ─── CORE VALUES ─────────────────────────────────────────────────────── -->
  <section class="bg-white py-24 px-4">
    <div class="max-w-6xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold text-[#11133F] text-center mb-14">What We Stand For</h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {coreValues.map((v) => (
          <div class="bg-stone-50 rounded-2xl p-7 ring-1 ring-stone-200">
            <div class="w-10 h-10 bg-[#C22326] rounded-lg flex items-center justify-center mb-4">
              <span class="text-white font-bold text-sm">{v.letter}</span>
            </div>
            <h3 class="text-lg font-bold text-[#11133F] mb-2">{v.name}</h3>
            <p class="text-slate-600 text-sm leading-relaxed">{v.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── WHAT SETS US APART ──────────────────────────────────────────────── -->
  <section class="bg-stone-50 py-24 px-4">
    <div class="max-w-5xl mx-auto">
      <p class="text-sm font-semibold tracking-widest uppercase text-[#C22326] mb-4 text-center">What Sets Us Apart</p>
      <h2 class="text-3xl sm:text-4xl font-bold text-[#11133F] text-center mb-14">The Pro Exteriors Difference</h2>
      <div class="space-y-6">
        {differentiators.map((d) => (
          <div class="bg-white rounded-2xl p-8 ring-1 ring-stone-200">
            <h3 class="text-xl font-bold text-[#11133F] mb-2">{d.title}</h3>
            <p class="text-slate-600 leading-relaxed">{d.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ─── WHAT WE DO ──────────────────────────────────────────────────────── -->
  <section class="bg-[#11133F] py-24 px-4 text-white">
    <div class="max-w-4xl mx-auto">
      <h2 class="text-3xl sm:text-4xl font-bold mb-6 text-white">More Than Construction</h2>
      <p class="text-white/80 text-base sm:text-lg leading-relaxed mb-6">
        At Pro Exteriors, LLC, our work extends beyond construction. While we deliver high-quality exterior construction services, we are committed to building strong people and strong character.
      </p>
      <p class="text-white/80 text-base sm:text-lg leading-relaxed mb-6">
        We invest in the personal and spiritual development of our team and community through a structured discipleship program for men and women, supported by a chaplain on staff, weekly Bible studies, and the Men and Ladies of Honor programs.
      </p>
      <p class="text-white/80 text-base sm:text-lg leading-relaxed mb-10">
        Through Pro Ministries Outreach, we also serve our community by meeting practical needs and supporting underserved and underprivileged individuals and families — creating lasting impact where we live and work.
      </p>
      <a
        href="/pro-ministries/"
        class="inline-flex items-center justify-center px-8 py-3 bg-[#C22326] text-white font-semibold rounded-lg hover:bg-[#a81e20] transition-colors"
        data-cta-name="about_to_ministries"
      >
        Explore Pro Ministries <span aria-hidden="true" class="ml-1">→</span>
      </a>
    </div>
  </section>

  <!-- ─── CTA ─────────────────────────────────────────────────────────────── -->
  <section class="bg-white py-24 px-4">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-[#11133F] mb-6">Build with confidence.</h2>
      <p class="text-slate-700 text-lg leading-relaxed mb-10">
        Ready to get started? Contact Pro Exteriors today to schedule a consultation and experience the difference of working with a contractor committed to trust, integrity, and quality craftsmanship.
      </p>
      <a
        href="/contact/"
        class="inline-flex items-center justify-center px-10 py-4 bg-[#C22326] text-white text-lg font-bold rounded-lg hover:bg-[#a81e20] transition-colors"
        data-cta-name="about_cta_contact"
      >
        Schedule a Consultation
      </a>
      <p class="text-center text-slate-500 text-sm mt-10 tracking-wider">#BuiltOnFaith</p>
    </div>
  </section>
</BaseLayout>
