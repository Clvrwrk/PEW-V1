---
// 2026-05-29: Leadership/team consolidated into /team/ (Executive & Management
// Team). This route redirects to avoid duplicate content.
// See /decisions/2026-05-29-client-review-call-build-edits.md
const dest = '/team/';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${dest}`} />
    <link rel="canonical" href={dest} />
    <meta name="robots" content="noindex, follow" />
    <title>Redirecting to Team</title>
    <script set:html={`window.location.replace(${JSON.stringify(dest)});`}></script>
  </head>
  <body>
    <p>This page has moved. <a href={dest}>Continue to the Team page</a>.</p>
  </body>
</html>
