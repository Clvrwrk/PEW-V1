---
// 2026-05-29: Mission content consolidated into /about/ (About Us). This route
// now redirects to avoid duplicate content. See /decisions/2026-05-29-client-review-call-build-edits.md
const dest = '/about/';
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${dest}`} />
    <link rel="canonical" href={dest} />
    <meta name="robots" content="noindex, follow" />
    <title>Redirecting to About Us</title>
    <script set:html={`window.location.replace(${JSON.stringify(dest)});`}></script>
  </head>
  <body>
    <p>This page has moved. <a href={dest}>Continue to About Us</a>.</p>
  </body>
</html>
