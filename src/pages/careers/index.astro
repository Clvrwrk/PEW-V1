---
import BaseLayout from '../../components/seo/BaseLayout.astro';
import HeroSection from '../../components/molecules/HeroSection.astro';
import Breadcrumb from '../../components/molecules/Breadcrumb.astro';
import { breadcrumbSchema } from '../../lib/schema/BreadcrumbList';

const breadcrumbs = [
  { label: 'Home', href: '/' },
  { label: 'Careers', href: '/careers/' },
];
const schemaPayload = [breadcrumbSchema(breadcrumbs)];
---

<BaseLayout
  title="Careers at Pro Exteriors | Build a Long Career in Roofing"
  description="Pro Exteriors is hiring craftspeople, project managers, and operators. Local routes, real benefits, no storm-chasing. Ask about current openings."
  canonicalPath="/careers/"
  jsonLd={schemaPayload}
>
  <Breadcrumb items={breadcrumbs.slice(1)} />
  <HeroSection
    image="/images/commercial-hero.webp"
    title="Build Your Career with Pro Exteriors"
    subtitle="Local routes. Real benefits. A team that ships and a craft you can grow into."
    primaryCta={{ label: 'Email Us About Open Roles', href: 'mailto:Office@proexteriorsus.com?subject=Careers%20at%20Pro%20Exteriors' }}
  />
  <section class="py-16 px-4 max-w-3xl mx-auto">
    <p class="text-text-secondary">We hire field crews, project managers and office staff across our offices in Texas, Colorado, Kansas, Missouri, Georgia and Florida. To ask about current openings, email <a href="mailto:Office@proexteriorsus.com?subject=Careers%20at%20Pro%20Exteriors" class="text-accent font-semibold hover:underline">Office@proexteriorsus.com</a> with the role you are interested in and the office nearest you, or call <a href="tel:+18443367767" class="text-accent font-semibold hover:underline">844-336-PROS</a>.</p>
  </section>
</BaseLayout>
