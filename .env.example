# ─────────────────────────────────────────────────────────────────────────
# Lead intake: forms → /api/contact (Supabase) → /api/contact-sync (GHL)
# All server-side ONLY. Tokens/keys must never reach the browser or the repo.
# Runtime: astro.config output:"hybrid" + @astrojs/node (standalone).
# See tech/Website-CTA-GoHighLevel-Integration-Guide.md.
# ─────────────────────────────────────────────────────────────────────────

# Supabase — durable lead buffer (table: website_crm_contacts)
# URL + anon key are safe to expose (PUBLIC_); service-role key is NEVER PUBLIC_.
PUBLIC_SUPABASE_URL=https://rnhmvcpsvtqjlffpsayu.supabase.co
PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Shared secret guarding the internal /api/contact-sync call (generate: openssl rand -hex 32)
RETRY_SECRET=

# GoHighLevel — Private Integration Token (server-only). GHL_API_KEY is the
# house-standard name; GHL_PIT is accepted as a legacy fallback.
GHL_API_KEY=
GHL_PIT=
GHL_LOCATION_ID=uLuRBd8yQ9R64WLUxYGd
# Four-lane pipeline + New-stage IDs (verified live 2026-05-30). Override per client.
GHL_PIPELINE_RES_LEAD=wgX8HNbjhYWMtjcgefNn
GHL_STAGE_RES_LEAD=d4457a88-d9db-4f3e-8240-f04302e8fdbf
GHL_PIPELINE_COM_LEAD=F3Qes6CGurRcVMexypwT
GHL_STAGE_COM_LEAD=0c5c16f6-c70c-479e-bedd-158c5c86cc46
GHL_PIPELINE_RES_SVC=ETGpXgkWttwJD4zuj9i7
GHL_STAGE_RES_SVC=58b7d128-4472-4077-8719-37d1578e1633
GHL_PIPELINE_COM_SVC=8hYIhGQU1rf2g1nlFy82
GHL_STAGE_COM_SVC=64370db8-a9ed-4d3a-ad7b-a9d7079fa829

# Booking calendar embed (Calendly or GoHighLevel)
